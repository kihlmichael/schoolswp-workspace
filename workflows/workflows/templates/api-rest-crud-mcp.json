        "jsCode": "// Update Cache after GET\nconst resource = $json;\nconst cache = $getWorkflowStaticData('global').cache || {};\nconst cacheKey = `resource_${resource.id}`;\n\ncache[cacheKey] = {\n  data: resource,\n  timestamp: Date.now()\n};\n\n// Keep cache size manageable (max 1000 entries)\nconst keys = Object.keys(cache);\nif (keys.length > 1000) {\n  keys.slice(0, keys.length - 1000).forEach(k => delete cache[k]);\n}\n\n$setWorkflowStaticData('global', { cache });\n\nreturn [{ json: resource }];"
