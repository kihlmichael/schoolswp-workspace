    {
      "parameters": {
        "jsCode": "// Extract Request Data\nconst method = $input.first().json.method || 'GET';\nconst headers = $input.first().json.headers || {};\nconst body = $input.first().json.body || {};\nconst query = $input.first().json.query || {};\n\n// Extract resource ID from path\nconst resourceId = query.id || body.id || null;\n\nreturn [{\n  json: {\n    method,\n    resourceId,\n    data: body,\n    query,\n    headers,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "extract-input-1",
      "name": "Extract Request Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Validate Input with Joi\nconst Joi = require('joi');\nconst input = $json;\n\n// Schema based on method\nlet schema;\n\nswitch (input.method) {\n  case 'POST':\n  case 'PUT':\n    schema = Joi.object({\n      method: Joi.string().required(),\n      data: Joi.object({\n        name: Joi.string().min(2).max(200).required(),\n        email: Joi.string().email().optional(),\n        status: Joi.string().valid('active', 'inactive').default('active')\n      }).required()\n    });\n    break;\n  \n  case 'GET':\n  case 'DELETE':\n    schema = Joi.object({\n      method: Joi.string().required(),\n      resourceId: Joi.alternatives().try(\n        Joi.number().integer().positive(),\n        Joi.string().uuid()\n      ).required()\n    });\n    break;\n  \n  default:\n    throw new Error(`Unsupported HTTP method: ${input.method}`);\n}\n\nconst { error, value } = schema.validate(input, {\n  abortEarly: false,\n  stripUnknown: true\n});\n\nif (error) {\n  const errors = error.details.map(d => d.message);\n  throw new Error(`Validation failed: ${errors.join(', ')}`);\n}\n\nreturn [{ json: value }];"
      },
      "id": "validate-input-1",
      "name": "Validate Input Schema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// Check Rate Limit\nconst RATE_LIMIT = 100; // requests per minute\nconst WINDOW = 60000; // 1 minute\n\nconst clientIp = $json.headers['x-forwarded-for'] || 'unknown';\nconst rateLimits = $getWorkflowStaticData('global').rateLimits || {};\nconst clientData = rateLimits[clientIp] || { count: 0, windowStart: Date.now() };\n\nconst now = Date.now();\n\n// Reset window if expired\nif (now - clientData.windowStart > WINDOW) {\n  clientData.count = 0;\n  clientData.windowStart = now;\n}\n\n// Check limit\nif (clientData.count >= RATE_LIMIT) {\n  const waitTime = WINDOW - (now - clientData.windowStart);\n  throw new Error(`Rate limit exceeded. Retry after ${Math.ceil(waitTime / 1000)}s`);\n}\n\n// Increment counter\nclientData.count++;\nrateLimits[clientIp] = clientData;\n\n// Cleanup old entries (keep last 1000 IPs)\nconst ips = Object.keys(rateLimits);\nif (ips.length > 1000) {\n  ips.slice(0, ips.length - 1000).forEach(ip => delete rateLimits[ip]);\n}\n\n$setWorkflowStaticData('global', { rateLimits });\n\nreturn $input.all();"
      },
