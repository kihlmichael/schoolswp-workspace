        "jsCode": "// Update Prometheus Metrics\nconst method = $json.method;\nconst success = $json.success;\n\n// Increment counter (in real implementation, use prom-client)\nconst metrics = $getWorkflowStaticData('global').metrics || {\n  requests_total: 0,\n  requests_by_method: {}\n};\n\nmetrics.requests_total++;\nmetrics.requests_by_method[method] = (metrics.requests_by_method[method] || 0) + 1;\n\n$setWorkflowStaticData('global', { metrics });\n\nconsole.log(`[METRICS] Total requests: ${metrics.requests_total}, ${method}: ${metrics.requests_by_method[method]}`);\n\nreturn $input.all();"
      },
