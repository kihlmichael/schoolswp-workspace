      "parameters": {
        "jsCode": "// GET: Check Cache First\nconst resourceId = $json.resourceId;\nconst cache = $getWorkflowStaticData('global').cache || {};\nconst cacheKey = `resource_${resourceId}`;\nconst CACHE_TTL = 300000; // 5 minutes\n\nif (cache[cacheKey] && (Date.now() - cache[cacheKey].timestamp < CACHE_TTL)) {\n  console.log(`Cache hit for resource ${resourceId}`);\n  return [{ \n    json: { \n      ...cache[cacheKey].data,\n      _cached: true,\n      _cacheAge: Date.now() - cache[cacheKey].timestamp\n    } \n  }];\n}\n\nreturn [{ json: { resourceId, _cached: false } }];"
      },
