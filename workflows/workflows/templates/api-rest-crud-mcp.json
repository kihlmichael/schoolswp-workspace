        "jsCode": "// Invalidate Cache on Mutation\nconst method = $node[\"Route by HTTP Method\"].context.output;\nconst resourceId = $json.id || $json.resourceId;\n\nif (['POST', 'PUT', 'DELETE'].includes(method)) {\n  const cache = $getWorkflowStaticData('global').cache || {};\n  const cacheKey = `resource_${resourceId}`;\n  \n  delete cache[cacheKey];\n  $setWorkflowStaticData('global', { cache });\n  \n  console.log(`Cache invalidated for resource ${resourceId}`);\n}\n\nreturn $input.all();"
