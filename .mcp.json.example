{
  "mcpServers": {
    "n8n-mcp": {
      "command": "n8n-mcp",
      "args": [],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "https://schoolswp-n8n.wp1.host",
        "N8N_API_KEY": "YOUR_N8N_API_KEY_HERE"
      }
    },
    "_comment_launcher_pattern": "Les MCP suivants (rapidapi-* + discord + zipwp) injectent un secret via args. Pour eviter le leak via 'claude mcp list', ils passent par un launcher .mjs qui lit le secret depuis .claude/settings.local.json et spawn le binaire reel. Voir tools/mcp-servers/_launch-rapidapi.mjs, _launch-discord.mjs, _launch-zipwp.mjs.",
    "rapidapi-linkedin": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-rapidapi.mjs",
        "linkedin"
      ]
    },
    "rapidapi-twitter": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-rapidapi.mjs",
        "twitter"
      ]
    },
    "rapidapi-instagram": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-rapidapi.mjs",
        "instagram"
      ]
    },
    "rapidapi-youtube": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-rapidapi.mjs",
        "youtube"
      ]
    },
    "discord": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-discord.mjs"
      ]
    },
    "apify": {
      "command": "actors-mcp-server",
      "args": [],
      "env": {
        "APIFY_API_TOKEN": "YOUR_APIFY_API_TOKEN_HERE"
      }
    },
    "zipwp": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-zipwp.mjs"
      ]
    },
    "firecrawl": {
      "command": "firecrawl-mcp",
      "args": [],
      "env": {
        "FIRECRAWL_API_KEY": "YOUR_FIRECRAWL_API_KEY_HERE"
      }
    },
    "wisewand": {
      "command": "wisewand-mcp",
      "args": [],
      "env": {
        "WISEWAND_API_KEY": "YOUR_WISEWAND_API_KEY_HERE"
      }
    },
    "dataforseo": {
      "command": "dataforseo-mcp-server",
      "args": [],
      "env": {
        "DATAFORSEO_USERNAME": "YOUR_DATAFORSEO_USERNAME_HERE",
        "DATAFORSEO_PASSWORD": "YOUR_DATAFORSEO_PASSWORD_HERE"
      }
    },
    "github": {
      "command": "bash",
      "args": ["C:/Users/micha/.claude/mcp-github.sh"]
    },
    "novamira-schoolswp-com": {
      "command": "npx",
      "args": ["-y", "@automattic/mcp-wordpress-remote@latest"],
      "env": {
        "WP_API_URL": "https://schoolswp.com/wp-json/mcp/mcp-adapter-default-server",
        "WP_API_USERNAME": "YOUR_WP_USERNAME_HERE",
        "WP_API_PASSWORD": "YOUR_WP_APP_PASSWORD_HERE"
      }
    },
    "higgsfield": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "heygen": {
      "type": "http",
      "url": "https://mcp.heygen.com/mcp/v1/"
    }
  }
}
