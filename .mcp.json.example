{
  "mcpServers": {
    "n8n-mcp": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-n8n.mjs"
      ]
    },
    "_comment_launcher_pattern": "Tous les MCP stdio avec secret passent par un launcher .mjs qui lit le secret depuis .claude/settings.local.json (gitignored) et spawn le binaire reel. Cela evite le leak via 'claude mcp list'. Voir tools/mcp-servers/: _launch-n8n.mjs, _launch-rapidapi.mjs, _launch-discord.mjs, _launch-zipwp.mjs, _launch-mcp-stdio.mjs (generique : apify, firecrawl, nano-banana, novamira), _launch-fluent.mjs (5 Fluent MCPs), _launch-dataforseo.mjs.",
    "rapidapi-linkedin": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-rapidapi.mjs",
        "linkedin"
      ]
    },
    "rapidapi-twitter": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-rapidapi.mjs",
        "twitter"
      ]
    },
    "rapidapi-instagram": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-rapidapi.mjs",
        "instagram"
      ]
    },
    "rapidapi-youtube": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-rapidapi.mjs",
        "youtube"
      ]
    },
    "discord": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-discord.mjs"
      ]
    },
    "apify": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-mcp-stdio.mjs",
        "@apify/actors-mcp-server",
        "APIFY_TOKEN"
      ]
    },
    "zipwp": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-zipwp.mjs"
      ]
    },
    "firecrawl": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-mcp-stdio.mjs",
        "firecrawl-mcp",
        "FIRECRAWL_API_KEY"
      ]
    },
    "wisewand": {
      "command": "wisewand-mcp",
      "args": [],
      "env": {
        "WISEWAND_API_KEY": "YOUR_WISEWAND_API_KEY_HERE"
      }
    },
    "dataforseo": {
      "command": "dataforseo-mcp-server",
      "args": [],
      "env": {
        "DATAFORSEO_USERNAME": "YOUR_DATAFORSEO_USERNAME_HERE",
        "DATAFORSEO_PASSWORD": "YOUR_DATAFORSEO_PASSWORD_HERE"
      }
    },
    "github": {
      "command": "bash",
      "args": ["C:/Users/micha/.claude/mcp-github.sh"]
    },
    "novamira-schoolswp-com": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-mcp-stdio.mjs",
        "@automattic/mcp-wordpress-remote@latest",
        "WP_API_URL",
        "WP_API_USERNAME",
        "WP_API_PASSWORD"
      ]
    },
    "higgsfield": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "heygen": {
      "type": "http",
      "url": "https://mcp.heygen.com/mcp/v1/"
    },
    "thruuu": {
      "command": "node",
      "args": [
        "tools/mcp-servers/_launch-thruuu.mjs"
      ]
    }
  }
}
