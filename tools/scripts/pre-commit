#!/usr/bin/env bash
# schoolsWP pre-commit hook
# Checks Python files with ruff before committing
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

# Get staged Python files
PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
SKILL_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '.claude/skills/**/SKILL.md')

if [ -n "$SKILL_FILES" ]; then
  echo "[pre-commit] Validating SKILL structure..."
  if ! command -v python &> /dev/null; then
    echo "[pre-commit] python not found. Install Python or skip SKILL validation."
    exit 1
  fi
  python tools/scripts/validate_skills.py
fi

if [ -z "$PYTHON_FILES" ]; then
  exit 0
fi

echo "[pre-commit] Checking Python files with ruff..."

# Check if ruff is available
if ! command -v ruff &> /dev/null; then
  echo "[pre-commit] ruff not found. Install with: pip install ruff"
  echo "[pre-commit] Skipping Python checks."
  exit 0
fi

# Lint
echo "[pre-commit] Running ruff check..."
ruff check $PYTHON_FILES
LINT_EXIT=$?

# Format check (no auto-fix, just verify)
echo "[pre-commit] Running ruff format --check..."
ruff format --check $PYTHON_FILES
FORMAT_EXIT=$?

if [ $LINT_EXIT -ne 0 ] || [ $FORMAT_EXIT -ne 0 ]; then
  echo ""
  echo "[pre-commit] Fix with: ruff check --fix . && ruff format ."
  exit 1
fi

echo "[pre-commit] All checks passed."
