{
  "name": "[Prod] Thruuu Token Health Check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      },
      "id": "schedule-001",
      "name": "Every Monday 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "https://api.thruuu.com/api/user",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{$vars.THRUUU_JWT}}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-001",
      "name": "Check Thruuu Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-401",
              "leftValue": "={{$json.statusCode}}",
              "rightValue": 401,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-001",
      "name": "Token Expired?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "={{$vars.DISCORD_WEBHOOK_SEO}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"content\": \"⚠️ **Thruuu JWT expiré** — Renouveler le token dans n8n Variables (`THRUUU_JWT`) avant le prochain audit SEO.\"}",
        "options": {}
      },
      "id": "http-002",
      "name": "Alert Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200]
    }
  ],
  "connections": {
    "Every Monday 9am": {
      "main": [[{ "node": "Check Thruuu Token", "type": "main", "index": 0 }]]
    },
    "Check Thruuu Token": {
      "main": [[{ "node": "Token Expired?", "type": "main", "index": 0 }]]
    },
    "Token Expired?": {
      "main": [
        [{ "node": "Alert Discord", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
