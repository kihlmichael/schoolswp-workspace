{
  "name": "[InDev] Agent Orchestrator: Callback > Process Result",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agent-callback",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-callback",
      "name": "Webhook: Agent Callback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "agent-callback"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({\"received\": true}) }}"
      },
      "id": "respond-ok",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [220, 160]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "field-run-id",
              "name": "run_id",
              "value": "={{ $json.run_id }}",
              "type": "string"
            },
            {
              "id": "field-summary",
              "name": "summary",
              "value": "={{ $json.synthesis.summary }}",
              "type": "string"
            },
            {
              "id": "field-priority",
              "name": "priority_actions",
              "value": "={{ JSON.stringify($json.synthesis.priority_actions) }}",
              "type": "string"
            },
            {
              "id": "field-conflicts",
              "name": "conflicts",
              "value": "={{ JSON.stringify($json.synthesis.conflicts) }}",
              "type": "string"
            },
            {
              "id": "field-next-steps",
              "name": "next_steps",
              "value": "={{ JSON.stringify($json.synthesis.next_steps) }}",
              "type": "string"
            },
            {
              "id": "field-agents",
              "name": "agents_called",
              "value": "={{ JSON.stringify($json.agents_called) }}",
              "type": "string"
            },
            {
              "id": "field-tokens",
              "name": "tokens_estimated",
              "value": "={{ $json.meta.total_tokens_estimated }}",
              "type": "number"
            }
          ]
        }
      },
      "id": "process-result",
      "name": "Extract Synthesis",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 420]
    }
  ],
  "connections": {
    "Webhook: Agent Callback": {
      "main": [
        [
          { "node": "Respond 200 OK", "type": "main", "index": 0 },
          { "node": "Extract Synthesis", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "notes": "Récepteur du callback multi-agents.\nURL webhook active: https://schoolswp-n8n.wp1.host/webhook/agent-callback\n\nFlux:\n1. API multi-agents appelle ce webhook quand l'analyse est terminée\n2. Répond 200 immédiatement (évite timeout côté API)\n3. En parallèle: extrait summary, priority_actions, conflicts, next_steps\n4. Brancher ici: Slack notification, Google Sheets, email, etc."
}
