{
  "name": "[InDev] Agent Orchestrator: Trigger > Async + Callback",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "task-field",
              "name": "task",
              "value": "Créer une page blog WordPress avec un composant React ArticleCard, une API REST WP et une optimisation SEO complète",
              "type": "string"
            }
          ]
        }
      },
      "id": "set-task",
      "name": "Set Task",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://schoolswp-agents.serveo.net/api/run",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({task: $json.task, callback_url: \"https://schoolswp-n8n.wp1.host/webhook/agent-callback\"}) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "run-agent-async",
      "name": "Run Agent (Async)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "run-id-field",
              "name": "run_id",
              "value": "={{ $json.run_id }}",
              "type": "string"
            },
            {
              "id": "status-field",
              "name": "status",
              "value": "={{ $json.status }}",
              "type": "string"
            },
            {
              "id": "stream-field",
              "name": "stream_url",
              "value": "={{ $json.stream_url }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "log-run-id",
      "name": "Log Run ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, 200]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [{ "node": "Set Task", "type": "main", "index": 0 }]
      ]
    },
    "Set Task": {
      "main": [
        [{ "node": "Run Agent (Async)", "type": "main", "index": 0 }]
      ]
    },
    "Run Agent (Async)": {
      "main": [
        [{ "node": "Log Run ID", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "notes": "Déclenche l'orchestrateur multi-agents en mode async.\nL'API répond immédiatement avec un run_id.\nLe résultat arrive via callback dans le workflow 'Agent Callback'.\n\nURL stable serveo.net : https://schoolswp-agents.serveo.net\nRequiert clé SSH enregistrée sur console.serveo.net"
}
