{
  "name": "[Prod] GSC > Notion: Weekly KPI Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "id": "schedule-001",
      "name": "Every Monday 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "query",
        "siteUrl": "https://schoolswp.com/",
        "startDate": "={{$now.minus({days: 28}).toFormat('yyyy-MM-dd')}}",
        "endDate": "={{$now.minus({days: 1}).toFormat('yyyy-MM-dd')}}",
        "dimensions": ["query"],
        "rowLimit": 100
      },
      "id": "gsc-001",
      "name": "Get GSC Data",
      "type": "n8n-nodes-base.googleSearchConsole",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst totalClicks = rows.reduce((s, r) => s + (r.json.clicks || 0), 0);\nconst totalImpressions = rows.reduce((s, r) => s + (r.json.impressions || 0), 0);\nconst avgCTR = totalImpressions > 0 ? (totalClicks / totalImpressions * 100).toFixed(2) : '0';\nconst avgPos = (rows.reduce((s, r) => s + (r.json.position || 0), 0) / rows.length).toFixed(1);\nreturn [{ json: { totalClicks, totalImpressions, avgCTR, avgPos, queriesCount: rows.length } }];"
      },
      "id": "code-001",
      "name": "Aggregate KPIs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": "={{$vars.NOTION_KPI_DB_ID}}",
        "title": "KPI Semaine {{$now.toFormat('yyyy-WW')}}",
        "propertiesUi": {
          "propertyValues": [
            { "key": "Clics", "type": "number", "numberValue": "={{$json.totalClicks}}" },
            { "key": "Impressions", "type": "number", "numberValue": "={{$json.totalImpressions}}" },
            { "key": "CTR (%)", "type": "number", "numberValue": "={{$json.avgCTR}}" },
            { "key": "Position moy.", "type": "number", "numberValue": "={{$json.avgPos}}" }
          ]
        }
      },
      "id": "notion-001",
      "name": "Create Notion KPI Page",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Every Monday 8am": { "main": [[{ "node": "Get GSC Data", "type": "main", "index": 0 }]] },
    "Get GSC Data": { "main": [[{ "node": "Aggregate KPIs", "type": "main", "index": 0 }]] },
    "Aggregate KPIs": { "main": [[{ "node": "Create Notion KPI Page", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
