{
  "name": "[Prod] Webhook > GSheets: Article Auto-Scorer",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "article-auto-scorer",
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "wh-001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "article-auto-scorer"
    },
    {
      "parameters": {
        "jsCode": "const secret = $input.first().headers['x-webhook-secret'];\nif (secret !== $vars.WEBHOOK_SECRET) {\n  throw new Error('Unauthorized');\n}\nreturn $input.all();"
      },
      "id": "code-001",
      "name": "Validate Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tu es un auditeur SEO expert. Score cet article /100 sur : Structure (25pts), Intent (25pts), Pédagogie (25pts), Business (25pts). Réponds uniquement avec un JSON : {\"score\": 82, \"breakdown\": {...}, \"top3_issues\": [...]}"
            },
            {
              "role": "user",
              "content": "={{$json.body.content}}"
            }
          ]
        },
        "options": { "maxTokens": 1000 }
      },
      "id": "openai-001",
      "name": "Score Article",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "={{$vars.GSHEET_SCORES_ID}}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "scores", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "keyword": "={{$('Webhook').item.json.body.keyword}}",
            "score": "={{JSON.parse($json.message.content).score}}",
            "scored_at": "={{new Date().toISOString()}}"
          },
          "matchingColumns": ["keyword"]
        },
        "options": {}
      },
      "id": "gsheet-001",
      "name": "Save Score",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "={{$vars.DISCORD_WEBHOOK_SEO}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"content\": \"**Score article** `\" + $('Webhook').item.json.body.keyword + \"`\\nScore : **\" + JSON.parse($('Score Article').item.json.message.content).score + \"/100**\"}",
        "options": {}
      },
      "id": "discord-001",
      "name": "Notify Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Validate Secret", "type": "main", "index": 0 }]] },
    "Validate Secret": { "main": [[{ "node": "Score Article", "type": "main", "index": 0 }]] },
    "Score Article": { "main": [[{ "node": "Save Score", "type": "main", "index": 0 }]] },
    "Save Score": { "main": [[{ "node": "Notify Discord", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
