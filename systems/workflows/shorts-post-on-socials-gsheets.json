        "sheetName": { "__rl": true, "value": "Videos", "mode": "list", "cachedResultName": "Videos" },
        "returnAll": true,
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [280, -960],
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
