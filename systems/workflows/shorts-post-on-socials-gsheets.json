      "credentials": {
        "googleSheetsOAuth2Api": { "id": "sxndIAF7riM6MHxu", "name": "Google Sheets - schoolsWP" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "cond-to-publish", "leftValue": "={{ $json['To Publish'] }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } },
            { "id": "cond-ig-not-posted", "leftValue": "={{ $json.Instagram }}", "rightValue": "", "operator": { "type": "boolean", "operation": "false", "singleValue": true } },
            { "id": "cond-tt-not-posted", "leftValue": "={{ $json.TikTok }}", "rightValue": "", "operator": { "type": "boolean", "operation": "false", "singleValue": true } },
            { "id": "cond-yt-not-posted", "leftValue": "={{ $json.Youtube }}", "rightValue": "", "operator": { "type": "boolean", "operation": "false", "singleValue": true } },
            { "id": "cond-video-exists", "leftValue": "={{ $json['Video URL'] }}", "rightValue": "", "operator": { "type": "string", "operation": "exists", "singleValue": true } },
            { "id": "cond-title-exists", "leftValue": "={{ $json.Title }}", "rightValue": "", "operator": { "type": "string", "operation": "exists", "singleValue": true } },
            { "id": "cond-keywords-exists", "leftValue": "={{ $json.Keywords }}", "rightValue": "", "operator": { "type": "string", "operation": "exists", "singleValue": true } },
            { "id": "cond-script-exists", "leftValue": "={{ $json.Script }}", "rightValue": "", "operator": { "type": "string", "operation": "exists", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [500, -960],
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Filter Ready to Publish"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length === 0) { return []; }\nreturn [items[0]];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, -960],
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Limit to 1"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Titre : {{ $json.Title }}\nScript : {{ $json.Script }}\nMots-clés : {{ $json.Keywords }}\nNiche : {{ $('Set Infos').item.json.Niche }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Tu es un copywriter expert. Génère 3 descriptions (Youtube, Instagram, TikTok) en JSON : {\"Youtube\":\"...\",\"Instagram\":\"...\",\"TikTok\":\"...\"}. Max 120 mots par description."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [100, -700],
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Generate Shorts Description"
