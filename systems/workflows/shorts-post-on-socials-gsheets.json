      "position": [-200, -960],
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "niche", "name": "Niche", "value": "Automatisations IA, Automatisation de process, CRM, Nocode", "type": "string" },
