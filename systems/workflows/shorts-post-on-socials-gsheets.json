          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [40, -960],
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Set Infos"
    },
    {
      "parameters": {
        "operation": "getAll",
