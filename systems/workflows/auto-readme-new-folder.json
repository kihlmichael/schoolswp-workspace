{
  "name": "[InDev] Google Drive → Docs: Auto-README New Folder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "n1",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "1PRdQvpjFOpM2DjC3oKdKVIAq8bK1pwMOGMSUbZW64oY",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Config",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Read Config — PageToken",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        400,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "1",
          "name": "GoogleSheets_Production_OAuth"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ String($json.value) }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n3",
      "name": "First Run?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/drive/v3/changes/startPageToken",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "supportsAllDrives",
              "value": "false"
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Get Initial PageToken",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        160
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "2",
          "name": "GoogleDrive_Production_OAuth"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "token",
              "value": "={{ $json.startPageToken }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Set Token — Initial",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1000,
        160
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a2",
              "name": "token",
              "value": "={{ $json.value }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "n6",
      "name": "Set Token — Stored",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        800,
        440
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/drive/v3/changes",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "pageToken",
              "value": "={{ $json.token }}"
            },
            {
              "name": "fields",
              "value": "changes(file(id,name,mimeType,parents,trashed)),nextPageToken,newStartPageToken"
            },
            {
              "name": "supportsAllDrives",
              "value": "false"
            },
            {
              "name": "includeItemsFromAllDrives",
              "value": "false"
            }
          ]
        },
        "options": {}
      },
      "id": "n7",
      "name": "Get Drive Changes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "2",
          "name": "GoogleDrive_Production_OAuth"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst nextToken = data.newStartPageToken || data.nextPageToken || '';\n\nconst newFolders = (data.changes || []).filter(c =>\n  c.file &&\n  c.file.mimeType === 'application/vnd.google-apps.folder' &&\n  !c.file.trashed\n).map(c => c.file);\n\nreturn [{\n  json: {\n    nextToken,\n    newFolders,\n    hasNewFolders: newFolders.length > 0\n  }\n}];"
      },
      "id": "n8",
      "name": "Filter New Folders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        300
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "1PRdQvpjFOpM2DjC3oKdKVIAq8bK1pwMOGMSUbZW64oY",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Config",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "key": "pageToken",
            "value": "={{ $json.nextToken }}"
          },
          "matchingColumns": [
            "key"
          ],
          "schema": [
            {
              "id": "key",
              "displayName": "key",
              "required": false,
              "defaultMatch": true,
              "canBeUsedToMatch": true,
              "display": true,
              "type": "string"
            },
            {
              "id": "value",
              "displayName": "value",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "n9",
      "name": "Save Next PageToken",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1600,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "1",
          "name": "GoogleSheets_Production_OAuth"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.hasNewFolders }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n10",
      "name": "New Folders Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1800,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "newFolders",
        "options": {}
      },
      "id": "n11",
      "name": "Split into Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        2000,
        160
      ]
    },
    {
      "parameters": {
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,name,parents"
            }
          ]
        },
        "options": {}
      },
      "id": "n12",
      "name": "Get Folder Info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        160
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "2",
          "name": "GoogleDrive_Production_OAuth"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $json.parents ? $json.parents[0] : 'root' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,name"
            }
          ]
        },
        "options": {}
      },
      "id": "n13",
      "name": "Get Parent Folder Name",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        160
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "2",
          "name": "GoogleDrive_Production_OAuth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const parentName = $input.first().json.name || 'Mon Drive';\nconst folderInfo = $('Get Folder Info').first().json;\n\nreturn [{\n  json: {\n    folderId: folderInfo.id,\n    folderName: folderInfo.name,\n    parentName,\n    folderPath: `${parentName}/${folderInfo.name}`\n  }\n}];"
      },
      "id": "n14",
      "name": "Build README Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        160
      ]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Tu gères la documentation d'un Google Drive appartenant à Michaël KIHL (projet schoolsWP — site WordPress pour formateurs).\\n\\nUn nouveau dossier vient d'être créé :\\n- Nom : {{ $json.folderName }}\\n- Chemin : {{ $json.folderPath }}\\n\\nRédige un README court et pratique pour ce dossier.\\n\\nStructure OBLIGATOIRE (texte brut, sans markdown ni symboles spéciaux) :\\n\\nLigne 1 : Nom du dossier suivi de /\\n\\nÀ QUOI ÇA SERT\\n2-3 phrases directes.\\n\\nCE QU'ON RANGE ICI\\n- point 1\\n- point 2\\n- point 3\\n- point 4\\n\\nCONVENTION DE NOMMAGE\\nAAAA-MM-JJ_projet_description.ext\\nExemple : 2026-03-14_schoolswp_nom-fichier.pdf\\n\\nÀ NE PAS METTRE ICI\\n- redirection 1\\n- redirection 2\\n\\nTon : direct, pratique, sans formules creuses. Langue : français. 150-200 mots max.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "n15",
      "name": "Generate README — Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2800,
        160
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "3",
          "name": "AnthropicAPI"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const claude = $input.first().json;\nconst readmeText = claude.content?.[0]?.text || '';\n\nif (!readmeText) throw new Error('Réponse Claude vide ou format inattendu');\n\nreturn [{\n  json: {\n    readmeText,\n    folderId: $('Build README Context').first().json.folderId,\n    folderName: $('Build README Context').first().json.folderName,\n    folderPath: $('Build README Context').first().json.folderPath\n  }\n}];"
      },
      "id": "n16",
      "name": "Extract README Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3000,
        160
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "method": "POST",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,name,webViewLink"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"README — {{ $json.folderName }}\",\n  \"mimeType\": \"application/vnd.google-apps.document\",\n  \"parents\": [\"{{ $json.folderId }}\"]\n}",
        "options": {}
      },
      "id": "n17",
      "name": "Create README Doc",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3200,
        160
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "2",
          "name": "GoogleDrive_Production_OAuth"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "=https://docs.googleapis.com/v1/documents/{{ $json.id }}:batchUpdate",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"requests\": [\n    {\n      \"insertText\": {\n        \"location\": { \"index\": 1 },\n        \"text\": {{ JSON.stringify($('Extract README Text').first().json.readmeText) }}\n      }\n    }\n  ]\n}",
        "options": {}
      },
      "id": "n18",
      "name": "Write README Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3400,
        160
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "2",
          "name": "GoogleDrive_Production_OAuth"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "https://docs.googleapis.com/v1/documents/1aH5RycPL86MklfsQVHS1jf19IbONpVotQm6t2f3IEXA:batchUpdate",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"requests\": [\n    {\n      \"insertText\": {\n        \"endOfSegmentLocation\": {},\n        \"text\": \"\\n{{ $('Extract README Text').first().json.folderPath }}/\\nhttps://docs.google.com/document/d/{{ $('Create README Doc').first().json.id }}/edit\\n\"\n      }\n    }\n  ]\n}",
        "options": {}
      },
      "id": "n19",
      "name": "Append Link to Hub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3600,
        160
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "2",
          "name": "GoogleDrive_Production_OAuth"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "1PRdQvpjFOpM2DjC3oKdKVIAq8bK1pwMOGMSUbZW64oY",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Folders",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "folder_id": "={{ $('Build README Context').first().json.folderId }}",
            "folder_name": "={{ $('Build README Context').first().json.folderName }}",
            "folder_path": "={{ $('Build README Context').first().json.folderPath }}",
            "readme_doc_id": "={{ $('Create README Doc').first().json.id }}",
            "readme_url": "=https://docs.google.com/document/d/{{ $('Create README Doc').first().json.id }}/edit",
            "detected_at": "={{ $now.toISO() }}",
            "status": "success"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "folder_id",
              "displayName": "folder_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string"
            },
            {
              "id": "folder_name",
              "displayName": "folder_name",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string"
            },
            {
              "id": "folder_path",
              "displayName": "folder_path",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string"
            },
            {
              "id": "readme_doc_id",
              "displayName": "readme_doc_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string"
            },
            {
              "id": "readme_url",
              "displayName": "readme_url",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string"
            },
            {
              "id": "detected_at",
              "displayName": "detected_at",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string"
            },
            {
              "id": "status",
              "displayName": "status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "n20",
      "name": "Log Success — Tracking Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        3800,
        160
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "1",
          "name": "GoogleSheets_Production_OAuth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const err = $input.first();\nreturn [{\n  json: {\n    errorMessage: err.json?.message || err.json?.error?.message || JSON.stringify(err.json),\n    errorAt: $now.toISO(),\n    workflow: '[InDev] Auto-README New Folder'\n  }\n}];"
      },
      "id": "n21",
      "name": "Collect Error Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        500
      ]
    },
    {
      "parameters": {
        "sendTo": "contact@michaelkihl.fr",
        "subject": "=⚠️ Auto-README Drive — Erreur",
        "emailType": "text",
        "message": "=Erreur dans le workflow Auto-README New Folder.\n\nDétail : {{ $json.errorMessage }}\nDate : {{ $json.errorAt }}\n\nVérifier dans n8n > Executions.",
        "options": {}
      },
      "id": "n22",
      "name": "Alert Email — Erreur",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        2200,
        500
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "4",
          "name": "Gmail_Production_OAuth"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "1PRdQvpjFOpM2DjC3oKdKVIAq8bK1pwMOGMSUbZW64oY",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Errors",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "error_at": "={{ $json.errorAt }}",
            "error_message": "={{ $json.errorMessage }}",
            "workflow": "={{ $json.workflow }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "error_at",
              "displayName": "error_at",
              "required": false,
