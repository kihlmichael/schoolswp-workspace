  ],
  "connections": {
    "Every 15 min": {
      "main": [
        [
          {
            "node": "Read Config — PageToken",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Config — PageToken": {
      "main": [
        [
          {
            "node": "First Run?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "First Run?": {
      "main": [
        [
          {
            "node": "Get Initial PageToken",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Set Token — Stored",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Initial PageToken": {
      "main": [
        [
          {
            "node": "Set Token — Initial",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Token — Initial": {
      "main": [
        [
          {
            "node": "Get Drive Changes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Token — Stored": {
      "main": [
        [
          {
            "node": "Get Drive Changes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Drive Changes": {
      "main": [
        [
          {
            "node": "Filter New Folders",
            "type": "main",
            "index": 0
          }
        ]
      ],
      "error": [
        [
          {
            "node": "Collect Error Info",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter New Folders": {
      "main": [
        [
          {
            "node": "Save Next PageToken",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Next PageToken": {
      "main": [
        [
          {
            "node": "New Folders Found?",
            "type": "main",
            "index": 0
