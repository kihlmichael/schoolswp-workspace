{
  "name": "[Prod] Drive Changes > Claude: Auto README New Folder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "trigger-001",
      "name": "Schedule: Every 5min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst lastRun = staticData.lastRunTime || new Date(Date.now() - 5 * 60 * 1000).toISOString();\nconst driveQuery = `mimeType='application/vnd.google-apps.folder' and createdTime>'${lastRun}' and trashed=false`;\nreturn [{ json: { lastRunTime: lastRun, driveQuery } }];"
      },
      "id": "code-001",
      "name": "Get LastRunTime",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.driveQuery }}"
            },
            {
              "name": "fields",
              "value": "files(id,name,mimeType,webViewLink,parents,createdTime)"
            },
            {
              "name": "orderBy",
              "value": "createdTime desc"
            },
            {
              "name": "pageSize",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "http-001",
      "name": "Drive: List New Folders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const response = items[0].json;\nconst files = response.files || [];\n\nconst staticData = $getWorkflowStaticData('global');\nstaticData.lastRunTime = new Date().toISOString();\n\nif (files.length === 0) {\n  return [{ json: { _hasResults: false } }];\n}\n\nreturn files.map(f => ({ json: { ...f, _hasResults: true } }));"
      },
      "id": "code-002",
      "name": "Parse Folders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-001",
              "leftValue": "={{ $json._hasResults }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-001",
      "name": "Has New Folders?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Génère un fichier README.md pour un nouveau dossier Google Drive.\n\nNom du dossier : {{ $json.name }}\nURL : {{ $json.webViewLink }}\nDate de création : {{ $json.createdTime }}\n\nLe README doit inclure :\n1. # Titre (nom du dossier)\n2. Description du contenu attendu (déduit du nom)\n3. Structure de sous-dossiers recommandée\n4. Conventions de nommage des fichiers\n5. Liens utiles\n\nTon : professionnel, concis. Langue : français."
      },
      "id": "chain-001",
      "name": "Generate README",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [1340, 220]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "maxTokens": 2000
        }
      },
      "id": "claude-001",
      "name": "OpenAI Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [1340, 420]
    },
    {
      "parameters": {
        "operation": "upload",
        "name": "README.md",
        "driveId": {
          "__rl": true,
          "value": "MyDrive",
          "mode": "list"
        },
        "folderId": {
          "__rl": true,
          "value": "={{ $('Has New Folders?').item.json.id }}",
          "mode": "id"
        },
        "binaryData": false,
        "fileContent": "={{ $json.text }}",
        "options": {
          "mimeType": "text/markdown"
        }
      },
      "id": "drive-001",
      "name": "Upload README",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1560, 220]
    },
    {
      "parameters": {
        "url": "={{$vars.DISCORD_WEBHOOK_SEO}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"content\": \"**README généré** pour `\" + $('Has New Folders?').item.json.name + \"`\\n\" + $('Has New Folders?').item.json.webViewLink}",
        "options": {}
      },
      "id": "discord-001",
      "name": "Notify Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$vars.HUB_SYNC_WEBHOOK}}",
        "options": {}
      },
      "id": "hub-sync-001",
      "name": "Trigger Hub Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 220]
    },
    {
      "parameters": {
        "content": "## 1. Schedule\nPoll toutes les 5 min.\nLit le lastRunTime depuis le workflow static data.",
        "height": 120,
        "width": 280,
        "color": 5
      },
      "id": "s1",
      "name": "Note — Schedule",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, 120]
    },
    {
      "parameters": {
        "content": "## 2. Drive Files API\nGET /drive/v3/files\nFiltre : mimeType=folder + createdTime > lastRunTime\nAuth : credential Google Drive OAuth2.",
        "height": 150,
        "width": 320,
        "color": 5
      },
      "id": "s2",
      "name": "Note — Drive API",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [620, 120]
    },
    {
      "parameters": {
        "content": "## 3. Génération README\nBasic LLM Chain (chainLlm) + Claude Sonnet 4.6.\nUn README par dossier. Upload en .md dans le dossier cible.",
        "height": 150,
        "width": 340,
        "color": 6
      },
      "id": "s3",
      "name": "Note — Generation",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1280, 60]
    }
  ],
  "connections": {
    "Schedule: Every 5min": {
      "main": [
        [
          {
            "node": "Get LastRunTime",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get LastRunTime": {
      "main": [
        [
          {
            "node": "Drive: List New Folders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Drive: List New Folders": {
      "main": [
        [
          {
            "node": "Parse Folders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Folders": {
      "main": [
        [
          {
            "node": "Has New Folders?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has New Folders?": {
      "main": [
        [
          {
            "node": "Generate README",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Generate README": {
      "main": [
        [
          {
            "node": "Upload README",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Model": {
      "ai_languageModel": [
        [
          {
            "node": "Generate README",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Upload README": {
      "main": [
        [
          {
            "node": "Notify Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Discord": {
      "main": [
        [
          {
            "node": "Trigger Hub Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
