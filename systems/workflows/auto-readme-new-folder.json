{
  "name": "[Prod] Drive Changes > Claude: Auto README New Folder",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [{ "mode": "everyMinute" }]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": { "__rl": true, "value": "={{$vars.DRIVE_WATCH_FOLDER_ID}}", "mode": "id" },
        "event": "folderCreated",
        "options": {}
      },
      "id": "trigger-001",
      "name": "Drive: New Folder",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const folder = $input.first().json;\nreturn [{ json: {\n  folder_id: folder.id,\n  folder_name: folder.name,\n  folder_url: folder.webViewLink,\n  parent_id: folder.parents ? folder.parents[0] : '',\n  created_time: folder.createdTime\n}}];"
      },
      "id": "code-001",
      "name": "Extract Folder Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "model": { "__rl": true, "value": "claude-sonnet-4-5-20250929", "mode": "id" },
        "messages": {
          "values": [{
            "role": "user",
            "content": "=Génère un fichier README.md pour un nouveau dossier Google Drive.\n\nNom du dossier : {{ $json.folder_name }}\nURL : {{ $json.folder_url }}\nDate de création : {{ $json.created_time }}\n\nLe README doit inclure :\n1. # Titre (nom du dossier)\n2. Description du contenu attendu (déduit du nom)\n3. Structure de sous-dossiers recommandée\n4. Conventions de nommage des fichiers\n5. Liens utiles\n\nTon : professionnel, concis. Langue : français."
          }]
        },
        "options": { "maxTokens": 2000 }
      },
      "id": "claude-001",
      "name": "Generate README",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "upload",
        "name": "README.md",
        "driveId": { "__rl": true, "value": "MyDrive", "mode": "list" },
        "folderId": { "__rl": true, "value": "={{ $('Extract Folder Info').item.json.folder_id }}", "mode": "id" },
        "binaryData": false,
        "fileContent": "={{ $json.text }}",
        "options": { "mimeType": "text/markdown" }
      },
      "id": "drive-001",
      "name": "Upload README",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "={{$vars.DISCORD_WEBHOOK_SEO}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"content\": \"**README généré** pour le dossier `\" + $('Extract Folder Info').item.json.folder_name + \"`\\n\" + $('Extract Folder Info').item.json.folder_url}",
        "options": {}
      },
      "id": "discord-001",
      "name": "Notify Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Drive: New Folder": { "main": [[{ "node": "Extract Folder Info", "type": "main", "index": 0 }]] },
    "Extract Folder Info": { "main": [[{ "node": "Generate README", "type": "main", "index": 0 }]] },
    "Generate README": { "main": [[{ "node": "Upload README", "type": "main", "index": 0 }]] },
    "Upload README": { "main": [[{ "node": "Notify Discord", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
