    {
      "id": "m4444444-4444-4444-8444-444444444444",
      "name": "Join + group by section",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const issueItems = $('Read issue_items (selected)').all().map(x => x.json);\nconst canonical = $input.all().map(x => x.json);\nconst byId = Object.fromEntries(canonical.map(c => [c.item_id, c]));\nconst joined = issueItems.map(ii => ({ ...ii, canonical: byId[ii.item_id] || {} }));\nconst sectionsOrder = ['sujet_principal','mises_a_jour_plugins','breves','offre','reco','pedagogie','business'];\nconst grouped = {};\nfor (const s of sectionsOrder) grouped[s] = [];\nfor (const j of joined) {\n  const s = j.section_type || 'breves';\n  if (!grouped[s]) grouped[s] = [];\n  grouped[s].push(j);\n}\nfor (const s of Object.keys(grouped)) grouped[s].sort((a,b) => (a.display_order||0) - (b.display_order||0));\nreturn [{ json: { grouped, order: sectionsOrder, issue_id: $env.CURRENT_ISSUE_ID } }];"
      }
    },
