    {
      "parameters": {
        "jsCode": "const errorData = $input.first().json;\nconst errorTime = new Date().toISOString();\n\nlet fileName = 'N/A';\ntry { fileName = $('Split into Items').item.json.name || 'N/A'; } catch(e) {}\n\nreturn [{ json: {\n  error_node: errorData.node || 'Unknown',\n  error_message: errorData.message || JSON.stringify(errorData),\n  error_time: errorTime,\n  file_name: fileName,\n  workflow: '[InDev] Auto-Rename on Move'\n}}];"
