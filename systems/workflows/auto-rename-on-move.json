    {
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/changes",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "pageToken", "value": "={{ $json.pageToken }}" },
            {
              "name": "fields",
              "value": "nextPageToken,newStartPageToken,changes(kind,type,removed,file(id,name,mimeType,parents))"
            },
            { "name": "includeItemsFromAllDrives", "value": "false" },
            { "name": "supportsAllDrives", "value": "false" }
          ]
