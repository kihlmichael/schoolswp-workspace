      "id": "http-004",
      "name": "Read README Text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3100, 300],
      "onError": "continueErrorOutput",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "OqaMtoHkGM18NYxs",
          "name": "GoogleDrive_Production_OAuth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract text content from Google Docs API response\nconst doc = $input.first().json;\nlet fullText = '';\n\nif (doc.body && doc.body.content) {\n  for (const element of doc.body.content) {\n    if (element.paragraph && element.paragraph.elements) {\n      for (const el of element.paragraph.elements) {\n        if (el.textRun && el.textRun.content) {\n          fullText += el.textRun.content;\n        }\n      }\n    }\n  }\n}\n\n// Extract naming convention section\nconst conventionMatch = fullText.match(/CONVENTION DE NOMMAGE[\\s\\S]*?\\n([\\s\\S]*?)(?:\\n\\n[A-Z\\u00C0-\\u00FF]|$)/);\nconst convention = conventionMatch ? conventionMatch[1].trim() : fullText.substring(0, 600);\n\n// Get file info from the Split into Items node\nconst fileInfo = $('Split into Items').item.json;\n\nreturn [{ json: {\n  fileId: fileInfo.id,\n  fileName: fileInfo.name,\n  fileMimeType: fileInfo.mimeType,\n  parentId: fileInfo.parentId,\n  convention: convention\n}}];"
      },
      "id": "code-003",
      "name": "Extract Convention",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3320, 300]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-haiku-4-5-20251001",
          "mode": "id"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=Tu dois renommer un fichier Google Drive selon la convention de nommage de son dossier.\n\nFichier actuel : {{ $json.fileName }}\nType MIME : {{ $json.fileMimeType }}\n\nConvention de nommage du dossier (extrait du README) :\n{{ $json.convention }}\n\nDate du jour : {{ new Date().toISOString().slice(0,10) }}\n\nG\u00e9n\u00e8re UNIQUEMENT le nouveau nom de fichier complet, sans guillemets, sans explication, sans extension. Respecte exactement la convention."
            }
          ]
        },
        "options": { "maxTokens": 200 }
      },
      "id": "claude-001",
      "name": "Generate New Name \u2014 Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [3540, 300],
      "onError": "continueErrorOutput",
      "credentials": {
        "anthropicApi": {
          "id": "LbtmeEcWjyAVK5OY",
          "name": "Anthropic_Production_API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json.text || '';\nconst newName = response.trim().split('\\n')[0].replace(/^[`\"'\\s]+|[`\"'\\s]+$/g, '').trim();\n\nconst fileInfo = $('Extract Convention').first().json;\n\nreturn [{ json: {\n  fileId: fileInfo.fileId,\n  fileName: fileInfo.fileName,\n  fileMimeType: fileInfo.fileMimeType,\n  newFileName: newName\n}}];"
      },
