      "id": "http-002",
      "name": "Get Drive Changes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300],
      "onError": "continueErrorOutput",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "OqaMtoHkGM18NYxs",
          "name": "GoogleDrive_Production_OAuth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst nextToken = data.nextPageToken || data.newStartPageToken || '';\nconst changes = data.changes || [];\n\nconst candidates = changes.filter(c => {\n  if (c.removed) return false;\n  if (!c.file) return false;\n  const f = c.file;\n  if (f.mimeType === 'application/vnd.google-apps.folder') return false;\n  if (!f.name) return false;\n  if (f.name.startsWith('README')) return false;\n  if (/^\\d{4}-\\d{2}-\\d{2}_/.test(f.name)) return false;\n  return true;\n});\n\nreturn [{ json: {\n  nextPageToken: nextToken,\n  files: candidates.map(c => ({\n    id: c.file.id,\n    name: c.file.name,\n    mimeType: c.file.mimeType,\n    parentId: c.file.parents ? c.file.parents[0] : ''\n  }))\n}}];"
      },
      "id": "code-002",
      "name": "Filter Changed Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 300]
