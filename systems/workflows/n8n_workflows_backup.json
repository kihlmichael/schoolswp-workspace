{
  "name": "n8n Workflows Backup — schoolsWP",
  "_meta": {
    "workflow_id": "iXR2tvSfd5L9zE2t",
    "status": "Prod",
    "description": "Backup quotidien des workflows n8n actifs vers Google Sheets (inventaire). Déclenché à 2h du matin.",
    "sheet_id": "1jzof-Yj44AHBEP1avLZ3YOoDMA1PK9b6t4jpuWaso3I",
    "sheet_tab": "inventory",
    "sheet_columns": [
      "workflow_id",
      "name",
      "url",
      "description",
      "nodes_used",
      "node_count",
      "drive_url",
      "backed_up_at"
    ]
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "a1b2c3d4-bb01-bb01-bb01-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "https://schoolswp-n8n.wp1.host/api/v1/workflows?limit=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-KEY",
              "value": "={{$env.N8N_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-bb02-bb02-bb02-000000000002",
      "name": "Get All Workflows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst workflows = data.data || [];\nconst active = workflows.filter(w => w.active === true);\nconst now = new Date().toISOString();\nreturn active.map(wf => {\n  const nodes = wf.nodes || [];\n  const nodeTypes = [...new Set(\n    nodes.map(n => n.type\n      .replace('n8n-nodes-base.', '')\n      .replace('@n8n/n8n-nodes-langchain.', 'AI:')\n    )\n  )].sort().join(', ');\n  return {\n    json: {\n      workflow_id: wf.id,\n      name: wf.name,\n      url: 'https://schoolswp-n8n.wp1.host/workflow/' + wf.id,\n      description: (wf.settings && wf.settings.description) ? wf.settings.description : '',\n      nodes_used: nodeTypes,\n      node_count: nodes.length,\n      drive_url: '',\n      backed_up_at: now\n    }\n  };\n});"
      },
      "id": "a1b2c3d4-bb03-bb03-bb03-000000000003",
      "name": "Prepare All",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "1jzof-Yj44AHBEP1avLZ3YOoDMA1PK9b6t4jpuWaso3I",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "inventory",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": ["workflow_id"],
          "schema": []
        },
        "options": {}
      },
      "id": "a1b2c3d4-bb04-bb04-bb04-000000000004",
      "name": "Update Inventory",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Get All Workflows", "type": "main", "index": 0 }]]
    },
    "Get All Workflows": {
      "main": [[{ "node": "Prepare All", "type": "main", "index": 0 }]]
    },
    "Prepare All": {
      "main": [[{ "node": "Update Inventory", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
