        "mode": "runOnceForEachItem",
        "jsCode": "\n// Check if translation exists\nconst item = $('WordPress Trigger').item.json;\nif (!item.translations || !item.translations.en || !item.translations.de) {\n  return { \n    json: { \n      title: item.title.rendered, \n      link: item.link, \n      date: item.date,\n      status: 'A Traduire' \n    } \n  };\n} else {\n  // If translations exist, skip\n  return [];\n}\n    "
