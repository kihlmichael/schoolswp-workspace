        "mode": "runOnceForEachItem",
        "jsCode": "const cleanTitle = $json.title.rendered\n  .replace(/&amp;/g, '&')\n  .replace(/&#8211;/g, '-')\n  .replace(/&#8212;/g, '-')\n  .replace(/—/g, ' - ')\n  .replace(/–/g, ' - ')\n  .replace(/\\s+-\\s+/g, ' - ');\n\nreturn {\n  id: $json.id.toString(),\n  title: cleanTitle,\n  slug: $json.slug,\n  date: $json.date.split('T')[0],\n  link: $json.link\n};"
      },
