      "parameters": {
        "jsCode": "// Génère la liste des requêtes Firecrawl pour identifier la concurrence WordPress en Grand Est\nconst queries = [\n  'agence wordpress strasbourg',\n  'agence wordpress nancy',\n  'agence wordpress metz',\n  'agence wordpress reims',\n  'agence wordpress mulhouse',\n  'freelance wordpress grand est',\n  'création site wordpress alsace',\n  'création site wordpress lorraine',\n  'création site wordpress champagne ardenne',\n  'développeur wordpress strasbourg'\n];\nreturn queries.map(q => ({ json: { query: q } }));"
      },
      "id": "code-queries-w208a-001",
      "name": "Generate Local Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
