      "name": "Loop Over Queries",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.firecrawl.dev/v1/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"{{ $json.query }}\",\n  \"limit\": 10,\n  \"country\": \"fr\",\n  \"lang\": \"fr\"\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-firecrawl-w208a-001",
      "name": "Firecrawl Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "tDpWWa0q2KgN4SwC",
          "name": "Firecrawl"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extrait les top résultats et formatte pour append au sheet\nconst items = [];\nconst query = $('Loop Over Queries').item.json.query;\nconst results = $input.first().json.data || $input.first().json.results || [];\nfor (const r of results.slice(0, 10)) {\n  const url = r.url || r.link || '';\n  const title = r.title || r.metadata?.title || '';\n  const description = r.description || r.metadata?.description || r.snippet || '';\n  if (!url) continue;\n  // skip directories and aggregators\n  const skip = ['pagesjaunes', 'societe.com', 'malt.fr', 'codeur.com', 'fiverr', 'upwork', 'youtube.com'];\n  if (skip.some(s => url.includes(s))) continue;\n  // extract clean domain\n  let domain = '';\n  try { domain = new URL(url).hostname.replace('www.', ''); } catch (e) {}\n  items.push({ json: { query, url, domain, title: title.slice(0, 200), description: description.slice(0, 300) } });\n}\nreturn items;"
      },
