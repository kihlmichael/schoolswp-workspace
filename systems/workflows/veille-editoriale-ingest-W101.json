    {
      "id": "f1111111-1111-4111-8111-111111111111",
      "name": "LLM Extract structured",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2660,
        250
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 800,\n  \"system\": \"Tu es un extracteur JSON strict pour la veille editoriale schoolsWP. Tu recois un titre + extrait d'un item (RSS, email, blog). Retourne UNIQUEMENT un JSON valide avec les champs: primary_brand, primary_product, version_detected, event_type (parmi: product_update, major_release, bugfix_release, security_update, launch, feature_announcement, partnership, promotion, acquisition, tutorial_resource, business_signal, ecosystem_news), impact_level (low|medium|high|critical), offer_type (discount|ltd|bundle|free_trial|coupon|null), offer_deadline (YYYY-MM-DD ou null), key_points (array de 2-4 strings), headline_normalized, summary_normalized (max 400 chars).\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Titre: {{ $json.title_raw }}\\n\\nMarque hint: {{ $json.brand_name }}\\n\\nExtrait: {{ $json.excerpt_raw }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "LbtmeEcWjyAVK5OY",
          "name": "Anthropic_Production_ApiKey"
        }
      }
    },
    {
      "id": "f2222222-2222-4222-8222-222222222222",
      "name": "Parse LLM + score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3100,
        250
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const simpleHash = (str) => { let h1 = 0xdeadbeef, h2 = 0x41c6ce57; for (let i = 0; i < str.length; i++) { const c = str.charCodeAt(i); h1 = Math.imul(h1 ^ c, 2654435761); h2 = Math.imul(h2 ^ c, 1597334677); } h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909); h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909); return (4294967296 * (2097151 & h2) + (h1 >>> 0)).toString(16).padStart(13, '0'); };\nconst out = [];\nfor (const item of items) {\n  const d = item.json;\n  const llmRaw = d.llm_response || '{}';\n  let ext = {};\n  try { ext = JSON.parse(llmRaw.replace(/^```json|```$/g, '').trim()); } catch { ext = {}; }\n\n  const title = (ext.headline_normalized || d.title_raw || '').toLowerCase();\n  const summary = (ext.summary_normalized || d.excerpt_raw || '').toLowerCase();\n  const text = title + ' ' + summary;\n\n  const impactMap = { low: 5, medium: 11, high: 16, critical: 20 };\n  const impact_score = impactMap[ext.impact_level] || 8;\n\n  const ageDays = (Date.now() - new Date(d.source_published_at).getTime()) / 86400000;\n  const freshness_score = ageDays < 3 ? 15 : ageDays < 7 ? 12 : ageDays < 14 ? 8 : 3;\n\n  const schoolsKeywords = ['wordpress','plugin','freelance','createur','formateur','lms','crm','seo','automatisation','kadence','fluent','tutor','elementor','woocommerce'];\n  const audience_fit_score = Math.min(20, schoolsKeywords.filter(k => text.includes(k)).length * 4);\n\n  const actionVerbs = ['tester','mettre a jour','mettre à jour','activer','configurer','installer','reduire','economiser','ameliorer','améliorer'];\n  const actionability_score = Math.min(15, actionVerbs.filter(v => text.includes(v)).length * 5);\n\n  const novelty_score = (ext.event_type === 'major_release' || ext.event_type === 'launch') ? 8 : 5;\n  const business_value_score = ext.offer_type && ext.offer_type !== 'null' ? 8 : (ext.event_type === 'partnership' ? 6 : 3);\n  const pedagogical_value_score = ext.event_type === 'tutorial_resource' ? 9 : (Array.isArray(ext.key_points) && ext.key_points.length >= 3 ? 6 : 3);\n\n  const noiseMarkers = ['excited to announce','game-changer','revolutionary','unprecedented'];\n  const noise_penalty = -Math.min(20, noiseMarkers.filter(n => text.includes(n)).length * 8);\n\n  const cluster_key = simpleHash(`${(ext.primary_product||'').toLowerCase()}|${ext.version_detected||''}|${ext.event_type||''}`);\n  const editorial_score = impact_score + freshness_score + audience_fit_score + actionability_score + novelty_score + business_value_score + pedagogical_value_score + noise_penalty;\n\n  let status_editorial = 'rejected', reason_rejected = 'score_too_low';\n  if (editorial_score >= 65) { status_editorial = 'candidate'; reason_rejected = ''; }\n  else if (editorial_score >= 50) { status_editorial = 'backlog'; reason_rejected = ''; }\n\n  const item_id = `ITEM-${new Date().toISOString().slice(0,10).replace(/-/g,'')}-${cluster_key.slice(0,6)}`;\n\n  out.push({ json: {\n    item_id, cluster_key,\n    raw_id: d.raw_id,\n    primary_brand: ((ext.primary_brand || d.brand_name || '').trim().toLowerCase() === 'unknown' ? '' : (ext.primary_brand || d.brand_name || '').trim()),\n    primary_product: ext.primary_product || '',\n    version_detected: ext.version_detected || '',\n    event_type: ext.event_type || 'ecosystem_news',\n    impact_level: ext.impact_level || 'low',\n    release_date: d.source_published_at,\n    first_seen_at: d.ingested_at,\n    last_seen_at: d.ingested_at,\n    headline_normalized: ext.headline_normalized || d.title_raw,\n    summary_normalized: ext.summary_normalized || d.excerpt_raw,\n    key_points: Array.isArray(ext.key_points) ? ext.key_points.join(';') : '',\n    offer_type: ext.offer_type && ext.offer_type !== 'null' ? ext.offer_type : '',\n    offer_deadline: ext.offer_deadline && ext.offer_deadline !== 'null' ? ext.offer_deadline : '',\n    links_primary: d.canonical_url,\n    source_count: 1,\n    impact_score, freshness_score, audience_fit_score, actionability_score,\n    novelty_score, business_value_score, pedagogical_value_score, noise_penalty,\n    editorial_score, confidence_score: 0.8,\n    status_editorial, reason_rejected\n  }});\n}\nreturn out;"
      }
    },
