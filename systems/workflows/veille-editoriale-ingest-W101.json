      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "Normalize email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        500
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const simpleHash = (str) => { let h1 = 0xdeadbeef, h2 = 0x41c6ce57; for (let i = 0; i < str.length; i++) { const c = str.charCodeAt(i); h1 = Math.imul(h1 ^ c, 2654435761); h2 = Math.imul(h2 ^ c, 1597334677); } h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909); h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909); return (4294967296 * (2097151 & h2) + (h1 >>> 0)).toString(16).padStart(13, '0'); };\nconst stripHtml = (h) => (h || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\nconst out = [];\nfor (const item of items) {\n  const m = item.json;\n  const subject = m.subject || '';\n  const fromObj = m.from || {};\n  const fromEmail = (fromObj.value && fromObj.value[0] && fromObj.value[0].address) || fromObj.text || '';\n  const fromName = (fromObj.value && fromObj.value[0] && fromObj.value[0].name) || fromEmail;\n  const body = stripHtml(m.text || m.textAsHtml || m.html || m.snippet || '');\n  out.push({ json: {\n    source_channel: 'email',\n    source_id: 'SRC-004',\n    source_url: '',\n    canonical_url: '',\n    email_message_id: m.messageId || m.id || '',\n    title_raw: subject,\n    excerpt_raw: body.slice(0, 500),\n    body_raw: body,\n    source_published_at: m.date || (m.internalDate ? new Date(Number(m.internalDate)).toISOString() : new Date().toISOString()),\n    ingested_at: new Date().toISOString(),\n    language: 'fr',\n    fetch_status: 'ok',\n    hash_raw: simpleHash((m.messageId || m.id || '') + subject),\n    brand_name: fromName\n  }});\n}\nreturn out;"
      }
    },
    {
      "id": "c1111111-1111-4111-8111-111111111111",
      "name": "Normalize RSS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        200
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const simpleHash = (str) => { let h1 = 0xdeadbeef, h2 = 0x41c6ce57; for (let i = 0; i < str.length; i++) { const c = str.charCodeAt(i); h1 = Math.imul(h1 ^ c, 2654435761); h2 = Math.imul(h2 ^ c, 1597334677); } h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909); h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909); return (4294967296 * (2097151 & h2) + (h1 >>> 0)).toString(16).padStart(13, '0'); };\nconst stripUTM = (u) => { try { const url = new URL(u); ['utm_source','utm_medium','utm_campaign','utm_term','utm_content'].forEach(k => url.searchParams.delete(k)); return url.toString(); } catch { return u || ''; } };\nconst stripHtml = (h) => (h || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\nconst out = [];\nfor (const item of items) {\n  const j = item.json;\n  if (j.error || !j.title) continue;\n  const link = j.link || j.url || j.guid || '';\n  const title = j.title || '';\n  const excerpt = stripHtml(j.contentSnippet || j.description || j.content || '').slice(0, 500);\n  const body = stripHtml(j.content || j.description || j.contentSnippet || '');\n  out.push({ json: {\n    source_channel: 'rss',\n    source_id: j.source_id || '',\n    brand_name: j.brand_name || '',\n    source_url: link,\n    canonical_url: stripUTM(link),\n    email_message_id: '',\n    title_raw: title,\n    excerpt_raw: excerpt,\n    body_raw: body,\n    source_published_at: j.pubDate || j.isoDate || j.date || new Date().toISOString(),\n    ingested_at: new Date().toISOString(),\n    language: 'fr',\n    fetch_status: 'ok',\n    hash_raw: simpleHash(link + title)\n  }});\n}\nreturn out;"
      }
    },
