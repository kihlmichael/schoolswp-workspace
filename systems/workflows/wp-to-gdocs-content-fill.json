      "id": "fetch_wp",
      "name": "Fetch WP Posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "// Extract posts and pagination info\nconst response = $input.first().json;\nconst posts = response.body;\nconst totalPages = parseInt(response.headers['x-wp-totalpages'] || '1');\nconst currentPage = parseInt($('Config').first().json.page);\n\n// Get parent folder based on article categories\n// FR cat IDs: parent=0, ID < 1880\n// EN cat IDs: parent=0, 1880-2079  \n// DE cat IDs: parent=0, >= 2080\nconst folderFR = $('Config').first().json.drive_folder_fr;\nconst folderEN = $('Config').first().json.drive_folder_en;\nconst folderDE = $('Config').first().json.drive_folder_de;\n\nconst results = [];\nfor (const post of posts) {\n  const title = post.title.rendered\n    .replace(/&#8217;/g, \"'\")\n    .replace(/&#8211;/g, \"-\")\n    .replace(/&#8230;/g, \"...\")\n    .replace(/&amp;/g, \"&\")\n    .replace(/&#038;/g, \"&\")\n    .replace(/&nbsp;/g, \" \")\n    .replace(/&rsquo;/g, \"'\")\n    .replace(/&lsquo;/g, \"'\")\n    .replace(/&rdquo;/g, '\"')\n    .replace(/&ldquo;/g, '\"')\n    .replace(/<[^>]+>/g, '');\n  \n  // Determine language from categories\n  const cats = post.categories || [];\n  let lang = 'fr';\n  let driveFolder = folderFR;\n  for (const catId of cats) {\n    if (catId >= 2080) { lang = 'de'; driveFolder = folderDE; break; }\n    if (catId >= 1880 && catId < 2080) { lang = 'en'; driveFolder = folderEN; break; }\n  }\n  \n  const date = post.date.substring(0, 10);\n  \n  // Convert HTML to plain text\n  let text = post.content.rendered;\n  text = text.replace(/<h[1-6][^>]*>(.*?)<\\/h[1-6]>/gs, '\\n\\n$1\\n\\n');\n  text = text.replace(/<p[^>]*>(.*?)<\\/p>/gs, '$1\\n\\n');\n  text = text.replace(/<br\\s*\\/?>/g, '\\n');\n  text = text.replace(/<li[^>]*>(.*?)<\\/li>/gs, '  - $1\\n');\n  text = text.replace(/<a[^>]*href=\"([^\"]*)\"[^>]*>(.*?)<\\/a>/gs, '$2');\n  text = text.replace(/<[^>]+>/g, '');\n  // Decode HTML entities\n  text = text.replace(/&#(\\d+);/g, (m, n) => String.fromCharCode(n));\n  text = text.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/&#039;/g, \"'\").replace(/&rsquo;/g, \"'\").replace(/&nbsp;/g, ' ');\n  text = text.replace(/\\n{3,}/g, '\\n\\n').trim();\n  \n  const header = `Source: ${post.link}\\nDate: ${date}\\n\\n${title}\\n${'='.repeat(Math.min(title.length, 60))}\\n\\n`;\n  const fullText = header + text;\n  \n  // Build drive search name (match the naming convention used in backup)\n  const langLabel = lang === 'fr' ? 'FR' : lang === 'en' ? 'EN' : 'DE';\n  const searchName = `${date} - ${title.substring(0, 40)}`;\n  \n  results.push({\n    json: {\n      wp_id: post.id,\n      title,\n      date,\n      slug: post.slug,\n      lang,\n      langLabel,\n      driveFolder,\n      searchName,\n      fullText,\n      link: post.link,\n      hasNextPage: currentPage < totalPages,\n      nextPage: currentPage + 1\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "parse_posts",
      "name": "Parse Posts & Convert HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
