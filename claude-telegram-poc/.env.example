# ============================================
# Configuration du Bot Telegram Claude Code
# ============================================
# Copiez ce fichier vers .env et remplissez vos valeurs
# cp .env.example .env
# ============================================

# Token du bot Telegram
# Obtenu via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=VOTRE_TOKEN_ICI

# Liste des user IDs autorisés (séparés par des virgules)
# Obtenu via @userinfobot sur Telegram
# Exemple: 123456789 ou 123456789,987654321
ALLOWED_USERS=VOTRE_USER_ID_ICI

# ============================================
# Options avancées (optionnel)
# ============================================

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timeout pour les appels Claude (en secondes)
CLAUDE_TIMEOUT=120

# Mode dry-run (true = simule sans appeler Claude)
DRY_RUN=false
