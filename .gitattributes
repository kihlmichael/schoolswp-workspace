# Auto-detect text files and normalize line endings
* text=auto

# Shell scripts must use LF
*.sh text eol=lf

# JSON workflows and configs
*.json text eol=lf

# Markdown
*.md text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Python
*.py text eol=lf

# Docker
Dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Environment templates
*.example text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
