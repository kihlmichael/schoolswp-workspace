{
  "_comment": "TEMPLATE de référence pour les 5 Fluent MCP servers (Carlos Rodera, MIT). À adapter en .mcp.json (gitignored) avec les paths absolus de la machine. Source upstream: https://github.com/carlosrodera/fluent-mcp-servers. Install: git clone dans tools/mcp-servers/fluent-mcp-servers/ + (cd <server> && npm install && npm run build) pour chacun des 5. Auth: launcher tools/mcp-servers/_launch-fluent.mjs lit .claude/settings.local.json (FLUENTCRM_API_USERNAME + FLUENTCRM_API_PASSWORD) et set process.env avant d'importer le serveur. Pourquoi un launcher: Claude Code ne résout pas la syntaxe ${VAR} dans le bloc env de .mcp.json (test 2026-04-29). Pour activer dynamic mode (~96% de réduction tokens au boot, recommandé), ajouter '--mode', 'dynamic' aux args de chaque serveur.",
  "mcpServers": {
    "fluentcrm": {
      "command": "node",
      "args": [
        "<ABSOLUTE_PATH_TO_PROJECT>/tools/mcp-servers/_launch-fluent.mjs",
        "FLUENTCRM",
        "fluent-crm-mcp",
        "--mode",
        "dynamic"
      ]
    },
    "fluentsupport": {
      "command": "node",
      "args": [
        "<ABSOLUTE_PATH_TO_PROJECT>/tools/mcp-servers/_launch-fluent.mjs",
        "FLUENTSUPPORT",
        "fluent-support-mcp",
        "--mode",
        "dynamic"
      ]
    },
    "fluentboards": {
      "command": "node",
      "args": [
        "<ABSOLUTE_PATH_TO_PROJECT>/tools/mcp-servers/_launch-fluent.mjs",
        "FLUENTBOARDS",
        "fluent-boards-mcp",
        "--mode",
        "dynamic"
      ]
    },
    "fluentcommunity": {
      "command": "node",
      "args": [
        "<ABSOLUTE_PATH_TO_PROJECT>/tools/mcp-servers/_launch-fluent.mjs",
        "FLUENTCOMMUNITY",
        "fluent-community-mcp",
        "--mode",
        "dynamic"
      ]
    },
    "fluentaffiliate": {
      "command": "node",
      "args": [
        "<ABSOLUTE_PATH_TO_PROJECT>/tools/mcp-servers/_launch-fluent.mjs",
        "FLUENTAFFILIATE",
        "fluent-affiliate-mcp",
        "--mode",
        "dynamic"
      ]
    }
  }
}
