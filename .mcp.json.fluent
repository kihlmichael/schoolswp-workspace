{
  "_comment": "Fluent ecosystem MCP servers — source: https://github.com/carlosrodera/fluent-mcp-servers (MIT, Carlos Rodera). Install: git clone + (cd <server> && npm install && npm run build). Auth: WordPress Application Passwords. Dynamic mode: append '--mode', 'dynamic' to args for ~96% token reduction. Replace /path/to/ with absolute clone path.",
  "mcpServers": {
    "fluentsupport": {
      "command": "node",
      "args": ["/path/to/fluent-mcp-servers/fluent-support-mcp/dist/index.js"],
      "env": {
        "FLUENTSUPPORT_URL": "https://schoolswp.com",
        "FLUENTSUPPORT_USERNAME": "${WP_USERNAME}",
        "FLUENTSUPPORT_APP_PASSWORD": "${WP_APP_PASSWORD}"
      }
    },
    "fluentcrm": {
      "command": "node",
      "args": ["/path/to/fluent-mcp-servers/fluent-crm-mcp/dist/index.js"],
      "env": {
        "FLUENTCRM_URL": "https://schoolswp.com",
        "FLUENTCRM_USERNAME": "${WP_USERNAME}",
        "FLUENTCRM_APP_PASSWORD": "${WP_APP_PASSWORD}"
      }
    },
    "fluentboards": {
      "command": "node",
      "args": ["/path/to/fluent-mcp-servers/fluent-boards-mcp/dist/index.js"],
      "env": {
        "FLUENTBOARDS_URL": "https://schoolswp.com",
        "FLUENTBOARDS_USERNAME": "${WP_USERNAME}",
        "FLUENTBOARDS_APP_PASSWORD": "${WP_APP_PASSWORD}"
      }
    },
    "fluentcommunity": {
      "command": "node",
      "args": ["/path/to/fluent-mcp-servers/fluent-community-mcp/dist/index.js"],
      "env": {
        "FLUENTCOMMUNITY_URL": "https://schoolswp.com",
        "FLUENTCOMMUNITY_USERNAME": "${WP_USERNAME}",
        "FLUENTCOMMUNITY_APP_PASSWORD": "${WP_APP_PASSWORD}"
      }
    },
    "fluentaffiliate": {
      "command": "node",
      "args": ["/path/to/fluent-mcp-servers/fluent-affiliate-mcp/dist/index.js"],
      "env": {
        "FLUENTAFFILIATE_URL": "https://schoolswp.com",
        "FLUENTAFFILIATE_USERNAME": "${WP_USERNAME}",
        "FLUENTAFFILIATE_APP_PASSWORD": "${WP_APP_PASSWORD}"
      }
    },
    "fluentcart": {
      "_comment": "Maintenu séparément par @vcode-sh — 279 tools, dynamic mode. Repo: https://github.com/vcode-sh/fchub-plugins — doc: https://fchub.co/fluentcart-mcp.",
      "command": "node",
      "args": ["/path/to/fchub-plugins/fluentcart-mcp/dist/index.js"],
      "env": {
        "FLUENTCART_URL": "https://schoolswp.com",
        "FLUENTCART_USERNAME": "${WP_USERNAME}",
        "FLUENTCART_APP_PASSWORD": "${WP_APP_PASSWORD}"
      }
    }
  }
}
