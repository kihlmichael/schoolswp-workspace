# ============================================================
# schoolsWP OS — .gitignore fortress
# ============================================================

# --- Secrets & credentials (NEVER commit) ---
.env
.env.*
!.env.example
*.env

# MCP config (contains API keys)
.mcp.json

# Claude Code local settings (may contain OAuth secrets)
.claude/settings.local.json

# OAuth tokens & credentials
*token*.json
*credentials*.json
*oauth*.json
gtoken.json
.gws-cli/

# API keys / certs
*.key
*.pem
*.p12
*.pfx
ccpa.config.json

# One-shot patch scripts (contain hardcoded n8n JWT)
patch_*.py
fix_workflow.py

# --- n8n sensitive files ---
systems/n8n-backup/
*backup_deploy*.json
n8n_workflows_backup_deploy.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- IDE / OS ---
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Temp / output ---
*.tmp
*.bak
*.orig
dist/

# --- Data & reports (large files) ---
data/reports/
data/exports/

# --- Apps: build outputs & heavy deps ---
apps/brand-reveal/brand-reveal/node_modules/
apps/brand-reveal/brand-reveal/out/
apps/video-marketing/video-marketing/node_modules/
apps/video-marketing/video-marketing/out/
apps/vscode-agent-visual/node_modules/
apps/vscode-agent-visual/dist/
apps/telegram-bot/telegram-bot/node_modules/
apps/_archive/claude-telegram-poc/venv/
