# ============================================================
# schoolsWP OS — .gitignore fortress
# ============================================================

# --- Secrets & credentials (NEVER commit) ---
.env
.env.*
!.env.example
*.env

# MCP config (contains API keys)
.mcp.json

# Claude Code local settings (may contain OAuth secrets)
.claude/settings.local.json

# Playwright MCP session artefacts (may contain cookies, tokens, auth headers)
.playwright-mcp/

# Formation FluentBoards — MP4 demos screen non versionnés (trop lourds, restent sur WP + copie locale)
content/formations/fluentboards/assets/demos/

# Formation WP Social Ninja — médias de prod (audio/vidéo générés, lourds). Les scripts .py restent versionnés.
content/formations/wpsocialninja/production/*.mp3
content/formations/wpsocialninja/production/*.mp4
content/formations/wpsocialninja/production/*.wav

# OAuth tokens & credentials
*token*.json
*credentials*.json
*oauth*.json
gtoken.json
.gws-cli/
.credentials/
!.credentials/README.md

# API keys / certs
*.key
*.pem
*.p12
*.pfx
ccpa.config.json

# One-shot patch scripts (contain hardcoded n8n JWT)
patch_*.py
fix_workflow.py

# --- n8n sensitive files ---
systems/n8n-backup/
*backup_deploy*.json
n8n_workflows_backup_deploy.json
# Snapshots de l'audit securite : JSON workflows complets (secrets hardcodes possibles) + metadata credentials. Local-only, jamais committer.
docs/security/09-backup/n8n-snapshot-*/
# Local n8n workflow exports : peuvent contenir secrets hardcodes (cles API, webhooks).
# Allowlist explicite ci-dessous des fichiers JSON valides a versionner.
systems/n8n/workflows/*.json
!systems/n8n/workflows/audit-monthly.json
!systems/n8n/workflows/thruuu-serp-analysis.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# But keep the n8n JS lib (pure modules copied verbatim into Code nodes).
!systems/n8n/lib/
!systems/n8n/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- IDE / OS ---
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Temp / output ---
*.tmp
*.bak
*.orig
dist/

# --- Data & reports (large files) ---
data/reports/
data/exports/

# --- Apps: build outputs & heavy deps ---
apps/brand-reveal/brand-reveal/node_modules/
apps/brand-reveal/brand-reveal/out/
apps/video-marketing/video-marketing/node_modules/
apps/video-marketing/video-marketing/out/
apps/vscode-agent-visual/node_modules/
apps/vscode-agent-visual/dist/
apps/telegram-bot/telegram-bot/node_modules/
apps/_archive/claude-telegram-poc/venv/

# --- Prototypes: nested external repos (own .git, lab use only) ---
apps/_prototypes/videoeditor/
.coverage
coverage.json
.firecrawl/
.agent/
.trash/
data/youtube-transcriptions/*
!data/youtube-transcriptions/*.md
!data/youtube-transcriptions/*.py
.aidesigner/*
!.aidesigner/.gitkeep

# --- External skills cloned as standalone upstream Git repos (phase d'evaluation) ---
# Quand le skill est valide en prod, retirer le sous-.git/ + cette ligne pour l'embed comme antigravity/ecc.
.claude/skills/external-video-use/
.claude/skills/external-heygen/

# --- External reference libraries (sparse-checkout, upstream MAJ frequente) ---
# YouMind awesome-gpt-image-2 : 2000+ prompts curés FR+EN, CC BY 4.0, MAJ daily
content/inspirations/awesome-gpt-image-2/

# --- External MCP servers cloned upstream (build localement, pas versionnes) ---
# Carlos Rodera - Fluent ecosystem MCP servers (5 plugins, dynamic mode)
tools/mcp-servers/fluent-mcp-servers/
# Anciennes versions archivees (Netfly FluentCRM MCP, etc.)
tools/mcp-servers/_legacy/

# --- mu-plugins deploy artifacts (base64 payloads + curl probes, reproducible) ---
tools/wp-mu-plugins/*.b64.tmp
tools/wp-mu-plugins/.live-check.tmp

# --- Local scratch / sandbox / one-shot probes (jamais committés) ---
# Throwaway python probes au niveau racine
/tmp-*.py
# Texte scratch à la racine (extracts d'articles, raw HTML pris à la pelle, etc.)
/*.txt
# Fichiers ad hoc (notes YouTube, etc.)
/test-yt.md
# Sandbox de session (exploration libre, jamais versionné)
sandbox-workspace/
# Backup local de .mcp.json (déjà gitignored, le backup l'est aussi)
.mcp.backup.json
# Scratch directory : 43+ probes / debug / deploy one-shot, souvent avec secrets hardcodés (JWT n8n). Jamais committer (alerte sécurité 2026-06-01).
scratch/

# --- HeyGen avatar identity files (IDs HeyGen perso, écrits par le skill heygen-avatar) ---
AVATAR-*.md

# --- Memory lint staging (transient, recree a chaque run du launcher) ---
tools/scripts/.lint-staging/

# InsForge & AI agent skills
.insforge
.agent
.agents
.augment
.claude
.cline
.github/copilot*
.kilocode
.qoder
.qwen
.roo
.trae
.windsurf
.codex

# --- One-shot n8n sync scripts (contain hardcoded JWTs from local debug sessions) ---
# Locale-only ; not committed. To version safely, patch each script to read N8N_API_KEY from env first.
scripts/n8n_sync_blog/
