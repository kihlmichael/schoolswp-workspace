# seo-audit-tracker - configuration du script Sheets
# Copie ce fichier en `scripts/.env` (gitignore) ou exporte ces variables dans ton shell.
# Le script ne contient AUCUN Sheet ID en dur : il lit SEO_AUDIT_SHEET_ID ici, via
# l'environnement, ou via --sheet-id.

# Tracker cumulatif (onglets FR / DE / EN). Valeur ci-dessous = Sheet de TEST fourni par Michaël.
# Pour changer de tracker, remplace simplement cet ID.
SEO_AUDIT_SHEET_ID=1_Sd_NePDGHg-gpY42efXOsS4mBzNLmqYLGtcb4NMohE

# Optionnel : dossier Drive où ranger les Sheets détaillés créés avec --detailed.
# Si vide, ils restent à la racine de Mon Drive.
# SEO_AUDIT_FOLDER_ID=
