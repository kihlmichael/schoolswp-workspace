        "jsCode": "// Extraire le tableau skills du payload\nconst payload = $input.first().json.body || $input.first().json;\nconst skills = payload.skills || [];\n\n// Retourner chaque skill comme item n8n séparé\nreturn skills.map(skill => ({\n  json: {\n    name: skill.name || '',\n    description: skill.description || '',\n    path: skill.path || '',\n    last_modified: skill.last_modified || '',\n    status: skill.status || 'new',\n    detected_at: skill.detected_at || new Date().toISOString().split('T')[0],\n    hash: skill.hash || ''\n  }\n}));"
      },
