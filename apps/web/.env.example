# InsForge backend — public client config (safe to expose; Row Level Security protects data).
# Get values with: npx @insforge/cli current   (URL = oss_host)
#                  npx @insforge/cli secrets get ANON_KEY
NEXT_PUBLIC_INSFORGE_URL=https://your-appkey.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-anon-key

# Public origin of this app (used for OAuth redirect URLs). Must be in the
# InsForge allowed_redirect_urls allowlist (see insforge.toml + config apply).
NEXT_PUBLIC_APP_URL=http://localhost:3000
