# ============================================================================
# n8n ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================================

# ----------------------------------------------------------------------------
# CORE N8N CONFIGURATION
# ----------------------------------------------------------------------------

# Encryption key for credentials (CRITICAL - Generate with: openssl rand -base64 32)
N8N_ENCRYPTION_KEY=GENERATE_WITH_OPENSSL_RAND_BASE64_32

# Host and Port Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678

# Path where n8n stores data
N8N_USER_FOLDER=~/.n8n

# ----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ----------------------------------------------------------------------------

# Basic Authentication (recommended for production)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# Session Configuration
N8N_JWTSECRET=GENERATE_RANDOM_JWT_SECRET
N8N_JWT_SESSION_DURATION_HOURS=168

# CORS Configuration
N8N_CORS_ALLOW_ORIGIN=*
N8N_CORS_CREDENTIALS=true

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------

# Database Type (sqlite | postgresdb | mysqldb | mariadb)
DB_TYPE=postgresdb

# PostgreSQL Configuration (recommended for production)
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=SECURE_DB_PASSWORD
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_SSL_CA=
DB_POSTGRESDB_SSL_CERT=
DB_POSTGRESDB_SSL_KEY=
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=true

# SQLite Configuration (only for development)
# DB_SQLITE_DATABASE=~/.n8n/database.sqlite

# ----------------------------------------------------------------------------
# EXTERNAL SECRETS MANAGEMENT (Optional but recommended for production)
# ----------------------------------------------------------------------------

# Provider: aws-secrets-manager | vault | gcp-secret-manager
# N8N_EXTERNAL_SECRETS_PROVIDER=aws-secrets-manager

# AWS Secrets Manager
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_SECRETS_MANAGER_PREFIX=n8n/

# HashiCorp Vault
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=your-vault-token
# VAULT_NAMESPACE=n8n
# VAULT_KV_PATH=secret/n8n

# GCP Secret Manager
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT_ID=your-project-id

# ----------------------------------------------------------------------------
# COMMUNITY PACKAGES & AI FEATURES
# ----------------------------------------------------------------------------

# Allow AI agents to use n8n tools (required for MCP integration)
N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE=true

# Community package installation
N8N_COMMUNITY_PACKAGES_ENABLED=true
N8N_COMMUNITY_PACKAGES_REGISTRY=https://registry.npmjs.org

# ----------------------------------------------------------------------------
# LOGGING & MONITORING
# ----------------------------------------------------------------------------

# Log Level: error | warn | info | verbose | debug
N8N_LOG_LEVEL=info

# Log Output: console | file
N8N_LOG_OUTPUT=console

# File logging configuration
N8N_LOG_FILE_LOCATION=~/.n8n/logs/
N8N_LOG_FILE_COUNT_MAX=100
N8N_LOG_FILE_SIZE_MAX_MB=16

# ----------------------------------------------------------------------------
# PERFORMANCE & EXECUTION
# ----------------------------------------------------------------------------

# Execution Process: main | own
EXECUTIONS_PROCESS=main

# Execution Timeout (seconds)
EXECUTIONS_TIMEOUT=300
EXECUTIONS_TIMEOUT_MAX=3600

# Number of executions to keep in database
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# Prune old executions
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

# Queue Mode (for high volume)
QUEUE_BULL_REDIS_HOST=localhost
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_DB=0
QUEUE_BULL_REDIS_PASSWORD=
QUEUE_BULL_REDIS_TIMEOUT_THRESHOLD=10000

# ----------------------------------------------------------------------------
# METRICS & PROMETHEUS
# ----------------------------------------------------------------------------

# Enable Prometheus metrics endpoint
N8N_METRICS=true
N8N_METRICS_INCLUDE_DEFAULT_METRICS=true
N8N_METRICS_INCLUDE_WORKFLOW_ID_LABEL=true
N8N_METRICS_INCLUDE_NODE_TYPE_LABEL=true
N8N_METRICS_PREFIX=n8n_
N8N_METRICS_INCLUDE_CREDENTIAL_TYPE_LABEL=false
N8N_METRICS_INCLUDE_API_ENDPOINTS=true
N8N_METRICS_INCLUDE_CACHE_METRICS=true

# ----------------------------------------------------------------------------
# WEBHOOKS CONFIGURATION
# ----------------------------------------------------------------------------

# Webhook URL (production should use HTTPS)
WEBHOOK_URL=http://localhost:5678/

# Webhook timeout
WEBHOOK_TIMEOUT=300000

# ----------------------------------------------------------------------------
# API CONFIGURATION
# ----------------------------------------------------------------------------

# Enable REST API
N8N_API_ENABLED=true

# API Key for programmatic access (generate with: openssl rand -hex 32)
N8N_API_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32

# Swagger UI
N8N_SWAGGER_UI_ENABLED=false

# ----------------------------------------------------------------------------
# MCP SERVER INTEGRATION CONFIGURATION
# ----------------------------------------------------------------------------

# OttoKit MCP Server (GitHub Automation)
MCP_OTTOKIT_ENDPOINT=https://mcp.ottokit.com/mcp/YOUR_OTTOKIT_KEY_HERE
MCP_OTTOKIT_ENABLED=true

# Firecrawl MCP Server (Web Scraping)
MCP_FIRECRAWL_API_KEY=fc-YOUR_FIRECRAWL_KEY_HERE
MCP_FIRECRAWL_ENDPOINT=https://api.firecrawl.dev/v1/mcp
MCP_FIRECRAWL_ENABLED=true

# Pabbly MCP Server (Workflow Automation)
MCP_PABBLY_ENDPOINT=https://connect.pabbly.com/mcp/YOUR_PABBLY_KEY_HERE
MCP_PABBLY_ENABLED=true

# DataForSEO MCP Server (SEO Analytics)
MCP_DATAFORSEO_LOGIN=your-email@example.com
MCP_DATAFORSEO_PASSWORD=YOUR_DATAFORSEO_PASSWORD
MCP_DATAFORSEO_ENDPOINT=https://api.dataforseo.com/v3/mcp
MCP_DATAFORSEO_ENABLED=true

# ----------------------------------------------------------------------------
# SMTP EMAIL CONFIGURATION (for error notifications)
# ----------------------------------------------------------------------------

# SMTP Settings
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=your-email@gmail.com
N8N_SMTP_PASS=your-app-specific-password
N8N_SMTP_SENDER=n8n-automation@example.com
N8N_SMTP_SSL=false

# ----------------------------------------------------------------------------
# TIMEZONE & LOCALIZATION
# ----------------------------------------------------------------------------

# Timezone for scheduled workflows
GENERIC_TIMEZONE=America/New_York

# Default language
N8N_DEFAULT_LOCALE=en

# ----------------------------------------------------------------------------
# DEVELOPMENT & DEBUG
# ----------------------------------------------------------------------------

# Node Environment
NODE_ENV=production

# Debug mode
N8N_DEBUG=false

# Skip user management setup
N8N_USER_MANAGEMENT_DISABLED=false

# ----------------------------------------------------------------------------
# MONITORING STACK (Grafana, Prometheus)
# ----------------------------------------------------------------------------

# Grafana Admin Password
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# Prometheus Retention
PROMETHEUS_RETENTION_TIME=15d

# ----------------------------------------------------------------------------
# DEPLOYMENT METADATA
# ----------------------------------------------------------------------------

# Environment Identifier
DEPLOYMENT_ENVIRONMENT=development
DEPLOYMENT_VERSION=1.0.0
DEPLOYMENT_NAME=n8n-primary

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PORT=5678

# ----------------------------------------------------------------------------
# CUSTOM ENVIRONMENT VARIABLES (for your workflows)
# ----------------------------------------------------------------------------

# Add your custom environment variables below
# These will be accessible in n8n workflows via $env.VARIABLE_NAME

# Example: External API Keys
# CUSTOM_API_SERVICE_KEY=your-api-key
# CUSTOM_WEBHOOK_SECRET=your-webhook-secret

# Example: Feature Flags
# FEATURE_ADVANCED_ANALYTICS=true
# FEATURE_BETA_WORKFLOWS=false

# Example: Business Configuration
# BUSINESS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# BUSINESS_NOTIFICATION_EMAIL=team@example.com

# ============================================================================
# END OF CONFIGURATION
# ============================================================================

# IMPORTANT SECURITY NOTES:
# 1. Generate strong random values for all secret keys
# 2. Never commit the actual .env file to version control
# 3. Use different encryption keys for each environment
# 4. Rotate secrets regularly (at least quarterly)
# 5. Use external secret managers in production (AWS Secrets Manager, Vault)
# 6. Limit access to .env file with appropriate file permissions (chmod 600)

# QUICK SETUP COMMANDS:
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Generate N8N_ENCRYPTION_KEY:
#    openssl rand -base64 32
#
# 3. Generate N8N_API_KEY:
#    openssl rand -hex 32
#
# 4. Generate JWT Secret:
#    openssl rand -base64 64
#
# 5. Set file permissions:
#    chmod 600 .env
#
# 6. Validate configuration:
#    bash scripts/validate-env.sh

# Firecrawl
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Skoatch (tools/skoatch/) — Bearer Sanctum, autre site WordPress que schoolswp.com
# Generer le token via https://skoatch.com/account/api ou via tools.skoatch.cli login
# Peut aussi etre stocke dans tools/skoatch/.env (override le .env racine).
SKOATCH_TOKEN=

# ----------------------------------------------------------------------------
# LLM AGENTS CONFIGURATION
# ----------------------------------------------------------------------------

# Anthropic (obligatoire — provider par defaut)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
MODEL_WRITER=claude-sonnet-4-6

# --- Providers alternatifs (optionnels) ---
# Prefixer le modele pour activer : MODEL_WRITER=gemini:gemini-2.0-flash
# OPENAI_API_KEY=sk-your-openai-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ----------------------------------------------------------------------------
# NOTIFICATIONS — brain.bat post-run (Discord + Telegram)
# ----------------------------------------------------------------------------
# Toutes les variables sont optionnelles : si vides, la notif est skippée silencieusement.
# Le script tools/scripts/notify-brain-done.py réutilise le bot Discord existant
# (DISCORD_BOT_TOKEN + DISCORD_CHANNEL_OUTPUTS pour OK, DISCORD_CHANNEL_ALERTS pour FAIL).

# ----------------------------------------------------------------------------
# DISCORD BOT — schoolsWP Orchestrator
# ----------------------------------------------------------------------------
# Bot Token : Developer Portal → ton app → Bot → Reset Token → copier une fois
# Client ID : Developer Portal → OAuth2 → Identifiant du client
# Guild ID  : clic droit serveur Discord (mode dev activé) → Copier l'identifiant
# DISCORD_BOT_TOKEN=MTxxxxxxxxxxxxxxxxxxxxxxxx.Gxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DISCORD_CLIENT_ID=1495134531743649873
# DISCORD_GUILD_ID=xxxxxxxxxxxxxxxxxx
#
# Salons (clic droit canal → Copier l'identifiant, mode dev activé dans Discord)
# DISCORD_CHANNEL_COMMANDS=   # canal où le bot écoute les slash commands
# DISCORD_CHANNEL_LOGS=       # logs techniques agents / n8n / brain.bat
# DISCORD_CHANNEL_ALERTS=     # erreurs, retries, failures
# DISCORD_CHANNEL_OUTPUTS=    # livrables (articles, cocons, meta)
#
# Telegram : le script notify-brain-done.py charge automatiquement les 4 bots
# déjà configurés dans agents/telegram-claude/.env (STUDIO/RADAR/FLOW/PULSE)
# et utilise TELEGRAM_TOKEN_STUDIO par défaut pour le content factory.
#
# Seule variable à ajouter ici : TELEGRAM_NOTIF_CHAT_ID (ton chat_id personnel
# pour recevoir les notifs en DM — écrire à @userinfobot sur Telegram pour l'obtenir).
# TELEGRAM_NOTIF_CHAT_ID=1020689775
#
# Override optionnel pour forcer un autre bot que STUDIO :
# TELEGRAM_NOTIF_TOKEN=<valeur de TELEGRAM_TOKEN_RADAR ou _FLOW ou _PULSE>

# ----------------------------------------------------------------------------
# FLUENTBOARDS — card auto sur audit publish_ready < seuil
# ----------------------------------------------------------------------------
# URL du webhook incoming FluentBoards (Settings → Incoming Webhooks → Add).
# Contient un hash unique qui agit comme token d'auth — traite-la comme un secret.
# Déclenché par `publish_ready --notify-fluentboards` si publish_score < threshold.
# FLUENTBOARDS_AUDIT_WEBHOOK_URL=https://schoolswp.com/?fbs=1&route=task&hash=xxxx

# ----------------------------------------------------------------------------
# DISCORD ROUTINES : webhook schoolsWP-Routines (channel #alerts)
# ----------------------------------------------------------------------------
# Webhook utilisé par les routines locales (ex : lint de la mémoire interne).
# Discord, paramètres du canal #alerts, Intégrations, Webhooks, copier l'URL.
# Optionnel : si vide, la notification est skippée silencieusement.
DISCORD_ROUTINES_WEBHOOK=
