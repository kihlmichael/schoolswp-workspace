{"name": "[Prod] Drive Changes > Claude: Auto README New Folder", "nodes": [{"parameters": {"rule": {"interval": [{"field": "minutes"}]}}, "id": "f801f1e7-cf44-48b1-9852-7afe7473a0c7", "name": "Schedule: Every 5min", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-3040, 2480]}, {"parameters": {"jsCode": "const staticData = $getWorkflowStaticData('global');\nconst lastRun = staticData.lastRunTime || new Date(Date.now() - 5 * 60 * 1000).toISOString();\nconst driveQuery = `mimeType='application/vnd.google-apps.folder' and createdTime>'${lastRun}' and trashed=false`;\nreturn [{ json: { lastRunTime: lastRun, driveQuery } }];"}, "id": "ba230f80-180f-4989-9981-49bec855a74c", "name": "Get LastRunTime", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-2816, 2480]}, {"parameters": {"url": "https://www.googleapis.com/drive/v3/files", "authentication": "predefinedCredentialType", "nodeCredentialType": "googleDriveOAuth2Api", "sendQuery": true, "queryParameters": {"parameters": [{"name": "q", "value": "={{ $json.driveQuery }}"}, {"name": "fields", "value": "files(id,name,mimeType,webViewLink,parents,createdTime)"}, {"name": "orderBy", "value": "createdTime desc"}, {"name": "pageSize", "value": "100"}]}, "options": {}}, "id": "09ba8003-d655-40df-9e45-047d522e57a7", "name": "Drive: List New Folders", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-2592, 2480], "credentials": {"googleDriveOAuth2Api": {"id": "OqaMtoHkGM18NYxs", "name": "Google Drive - schoolsWP v2"}}}, {"parameters": {"jsCode": "const response = items[0].json;\nconst files = response.files || [];\n\nconst staticData = $getWorkflowStaticData('global');\nstaticData.lastRunTime = new Date().toISOString();\n\nif (files.length === 0) {\n  return [{ json: { _hasResults: false } }];\n}\n\nreturn files.map(f => ({ json: { ...f, _hasResults: true } }));"}, "id": "be2887d2-dbb3-4b08-a504-dedbd3714505", "name": "Parse Folders", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-2368, 2480]}, {"parameters": {"conditions": {"options": {"caseSensitive": false, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"id": "cond-001", "leftValue": "={{ $json._hasResults }}", "rightValue": true, "operator": {"type": "boolean", "operation": "equals"}}], "combinator": "and"}, "options": {}}, "id": "d0402ed7-d686-4c7b-9e18-3e4db2231663", "name": "Has New Folders?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [-2144, 2480]}, {"parameters": {"promptType": "define", "text": "=G\u00e9n\u00e8re un fichier README.md pour un nouveau dossier Google Drive.\n\nNom du dossier : {{ $json.name }}\nURL : {{ $json.webViewLink }}\nDate de cr\u00e9ation : {{ $json.createdTime }}\n\nLe README doit inclure :\n1. # Titre (nom du dossier)\n2. Description du contenu attendu (d\u00e9duit du nom)\n3. Structure de sous-dossiers recommand\u00e9e\n4. Conventions de nommage des fichiers\n5. Liens utiles\n\nTon : professionnel, concis. Langue : fran\u00e7ais."}, "id": "f636e0ab-1584-4a5c-83ae-71f117fb1986", "name": "Generate README", "type": "@n8n/n8n-nodes-langchain.chainLlm", "typeVersion": 1.4, "position": [-1920, 2480]}, {"parameters": {"model": "gpt-4o-mini", "options": {"maxTokens": 2000}}, "id": "71dfcef2-0ab1-4aad-991a-93b1d2fca7dd", "name": "OpenAI Model", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "typeVersion": 1.2, "position": [-1848, 2704], "credentials": {"openAiApi": {"id": "X6XnXjSh420b4RgR", "name": "OpenAI \u2013 Prod"}}}, {"parameters": {"name": "README.md", "driveId": {"__rl": true, "value": "MyDrive", "mode": "list"}, "folderId": {"__rl": true, "value": "={{ $('Has New Folders?').item.json.id }}", "mode": "id"}, "options": {}}, "id": "b3304ef4-ef76-445b-b9b2-451299ddd5d0", "name": "Upload README", "type": "n8n-nodes-base.googleDrive", "typeVersion": 3, "position": [-1568, 2480], "credentials": {"googleDriveOAuth2Api": {"id": "OqaMtoHkGM18NYxs", "name": "Google Drive - schoolsWP v2"}}}, {"parameters"