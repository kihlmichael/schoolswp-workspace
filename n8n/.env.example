# ══════════════════════════════════════════════════════
#  schoolsWP — n8n Monthly Audit — Environment Variables
#  Copier en .env et remplir les valeurs (ne JAMAIS committer .env)
# ══════════════════════════════════════════════════════

# ── n8n Core ──────────────────────────────────────────
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678

# Timezone (OBLIGATOIRE pour le scheduling)
GENERIC_TIMEZONE=Europe/Paris
TZ=Europe/Paris

# Sécurité basique
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_strong_password

# Chiffrement des credentials
N8N_ENCRYPTION_KEY=changeme_32chars_random_key_here

# ── Base de données PostgreSQL ─────────────────────────
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=changeme_db_password
DB_POSTGRESDB_SCHEMA=public

# ── Code Node — modules autorisés ─────────────────────
NODE_FUNCTION_ALLOW_BUILTIN=fs,path,crypto,os
NODE_FUNCTION_ALLOW_EXTERNAL=

# ── Task Runner (n8n 2.0+) ────────────────────────────
N8N_RUNNERS_ENABLED=true

# ── Logs & Executions ─────────────────────────────────
N8N_LOG_LEVEL=info
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true
EXECUTIONS_DATA_MAX_AGE=168

# ── Audit Workflow — Variables métier ─────────────────

# Domaine cible
TARGET_DOMAIN=schoolswp.com

# Heure d'exécution (info documentaire — le cron est dans le workflow)
AUDIT_HOUR=9
AUDIT_DAY=20

# Forcer la relance même si le rapport existe déjà (true/false)
FORCE_RERUN=false

# Mode test — utilise des données mock, ne consomme pas les APIs
DATAFORSEO_DRY_RUN=false

# ── DataForSEO ────────────────────────────────────────
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password
DATAFORSEO_LOCATION=France
DATAFORSEO_LANGUAGE=French

# ── OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# ── Gmail ─────────────────────────────────────────────
# Credential créé dans n8n UI : Settings > Credentials > Gmail OAuth2 API
# (l'ID est généré par n8n après création — pas besoin ici)
REPORT_EMAIL_TO=contact@michaelkihl.fr

# ── Discord ───────────────────────────────────────────
# Créer un webhook : Serveur Discord > Paramètres > Intégrations > Webhooks
# Format : https://discord.com/api/webhooks/XXXXX/YYYYY
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── WhatsApp (CallMeBot — gratuit, usage personnel) ───
# Setup en 3 étapes :
#  1. Ajouter ce numéro en contact WA : +34 644 38 47 22
#  2. Lui envoyer le message exact : "I allow callmebot to send me messages"
#  3. Il répond avec ton apikey → la coller ici
# Format téléphone : international sans espaces ex: +33612345678
WHATSAPP_PHONE=+33612345678
WHATSAPP_CALLMEBOT_APIKEY=your_callmebot_api_key

# ── Stockage local ────────────────────────────────────
# Chemin dans le container (mappé via volume Docker)
ARTIFACTS_PATH=/artifacts

# ── S3 (optionnel) ────────────────────────────────────
S3_ENABLED=false
S3_BUCKET=schoolswp-reports
S3_REGION=eu-west-3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=seo-audits/

# ── PDF Service ───────────────────────────────────────
PDF_SERVICE_URL=http://pdf-service:3001
PDF_TIMEOUT_MS=30000

# ── Alerting erreurs ──────────────────────────────────
# En cas d'échec du workflow, n8n envoie une alerte sur Discord
ALERT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
ALERT_EMAIL=contact@michaelkihl.fr
